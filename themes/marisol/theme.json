    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#ff79c6",
    "FOCUSED_BC": "#bd93f9",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "false",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "0",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(20, 60)",
    "dunst_origin": "top-right",
    "dunst_transparency": "0",
    "dunst_corner_radius": "0",
    "dunst_font": "JetBrainsMono NF Medium 9",
    "dunst_border": "2",
    "dunst_frame_color": "#bd93f9",
    "dunst_icon_theme": "Dracula",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "right",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "right",
    "jg_bg": "#282a36",
    "jg_fg": "#f8f8f2",
    "jg_sel_bg": "#2f3240",
    "jg_sel_fg": "#f8f8f2",
    "jg_sep": "#bd93f9",
    "rofi_font": "JetBrainsMono NF Bold 9",
    "rofi_background": "#282a36",
    "rofi_bg_alt": "#2f3240",
    "rofi_background_alt": "#282a36E0",
    "rofi_fg": "#f8f8f2",
    "rofi_selected": "#bd93f9",
    "rofi_active": "#50fa7b",
    "rofi_urgent": "#ff6e6e",
    "sl_bg": "#282a36",
    "sl_fg": "#f8f8f2",
    "sl_ring": "#bd93f9",
    "sl_wrong": "#ff5555",
    "sl_date": "#f8f8f2",
    "sl_verify": "#50fa7b",
    "gtk_theme": "Dracula-zk",
    "gtk_icons": "Dracula",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-Dracula",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-01.webp",
  "bar_colors": {
    "bg": "#282a36",
    "bg-alt": "#282a36",
    "fg": "#f8f8f2",
    "mb": "#25292e",
    "trans": "#00282a36",
    "red": "#ff5555",
    "pink": "#d95d95",
    "purple": "#ff79c6",
    "blue": "#bd93f9",
    "blue-arch": "#0A9CF5",
    "cyan": "#8be9fd",
    "teal": "#00B19F",
    "green": "#50fa7b",
    "lime": "#B9C244",
    "yellow": "#f1fa8c",
    "amber": "#FBC02D",
    "orange": "#E57C46",
    "brown": "#AC8476",
    "grey": "#4c566a",
    "indigo": "#6C77BB",
    "blue-gray": "#63778f"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "true",
      "width": "100%",
      "height": "35",
      "offset-x": "0",
      "offset-y": "0",
      "background": "${color.trans}",
      "foreground": "${color.fg}",
      "radius": "0",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-top": "5px",
      "border-color": "${color.grey}",
      "padding": "0",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"JetBrainsMono:style=Bold:size=9;3\"",
      "font-1": "\"Font Awesome 6 Free Solid:size=9;3\"",
      "font-2": "\"Material Design Icons Desktop:size=11;3\"",
      "font-3": "\"Material Design Icons Desktop:size=15;3\"",
      "font-4": "\"MesloLGS NF:style=Regular:size=21;4\"",
      "modules-left": "sep launcher sep sep bspwm sep sep mpd_control sep bdgg sept title",
      "modules-center": "date sept weather",
      "modules-right": "tray bdv colorpicker usercard mplayer sep bluetooth sep sep battery sep sep cpu_bar sep sep memory_bar sep sep filesystem sep sep network sep sep pulseaudio sep sep updates sep sep power sep",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "marisol"
    }
  ],
  "modules": {
    "bdgg": {
      "type": "custom/text",
      "label": "\"%{T5}%{T-}\"",
      "label-foreground": "${color.grey}",
      "label-background": "${color.trans}"
    },
    "bdv": {
      "type": "custom/text",
      "label": "\"%{T5}%{T-}\"",
      "label-foreground": "${color.grey}",
      "label-background": "${color.trans}"
    },
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "format-background": "${color.trans}",
      "format-foreground": "${color.fg}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\" \"",
      "format-mounted-prefix-font": "2",
      "format-mounted-prefix-background": "${color.grey}",
      "format-mounted-prefix-foreground": "${color.yellow}",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix-font": "2",
      "format-unmounted-prefix": "\" \"",
      "label-mounted": "%used%",
      "label-mounted-background": "${color.grey}",
      "label-unmounted": "%mountpoint%: not mounted"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\" \"",
      "format-connected-prefix-font": "2",
      "format-connected-background": "${color.grey}",
      "format-connected-foreground": "${color.green}",
      "label-connected": "\"%netspeed%\"",
      "label-connected-background": "${color.grey}",
      "label-connected-foreground": "${color.amber}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\" \"",
      "format-disconnected-prefix-font": "2",
      "format-disconnected-prefix-background": "${color.grey}",
      "format-disconnected-foreground": "${color.red}",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-background": "${color.grey}",
      "label-disconnected-foreground": "${color.red}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "",
      "format-volume-prefix-font": "2",
      "format-volume-background": "${color.grey}",
      "format-volume-foreground": "${color.blue}",
      "label-volume": "\" %percentage%\"",
      "label-volume-background": "${color.grey}",
      "label-volume-foreground": "${color.fg}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "",
      "format-muted-prefix-font": "2",
      "format-muted-foreground": "${color.blue}",
      "format-muted-background": "${color.grey}",
      "label-muted": "\" Muted\"",
      "label-muted-foreground": "${color.red}",
      "label-muted-background": "${color.grey}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "format-background": "${color.grey}",
      "label": "\" %percentage%%\"",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "2",
      "ramp-foreground": "${color.yellow}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "label-charging-background": "${color.grey}",
      "label-charging": "\" %percentage%%\"",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "format-discharging-background": "${color.grey}",
      "label-discharging": "\" %percentage%%\"",
      "label-discharging-background": "${color.grey}",
      "format-full": "<label-full>",
      "format-full-prefix": "\" \"",
      "format-full-prefix-font": "2",
      "format-full-prefix-background": "${color.grey}",
      "format-full-prefix-foreground": "${color.green}",
      "label-full-background": "${color.grey}",
      "label-full": "\"%percentage%%\"",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-background": "${color.grey}",
      "ramp-capacity-foreground": "${color.yellow}",
      "ramp-capacity-font": "2"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\" %output% \""
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-font": "3",
      "label-focused": "󰮯",
      "label-focused-padding": "1",
      "label-focused-background": "${color.grey}",
      "label-focused-foreground": "${color.yellow}",
      "label-occupied": "󰊠",
      "label-occupied-padding": "1",
      "label-occupied-background": "${color.grey}",
      "label-occupied-foreground": "${color.blue}",
      "label-urgent": "󰊠",
      "label-urgent-padding": "1",
      "label-urgent-background": "${color.grey}",
      "label-urgent-foreground": "${color.blue}",
      "label-empty": "󰑊",
      "label-empty-padding": "1",
      "label-empty-background": "${color.grey}",
      "label-empty-foreground": "${color.purple}"
    },
    "title": {
      "type": "internal/xwindow",
      "format": "<label>",
      "format-prefix": "\"󱂬 \"",
      "format-prefix-foreground": "${color.purple}",
      "format-prefix-font": "3",
      "label": "%title%",
      "label-maxlen": "35",
      "label-foreground": "${color.cyan}",
      "label-empty": "Arch Linux",
      "label-empty-foreground": "${color.blue-gray}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.grey}",
      "format-prefix-foreground": "${color.green}",
      "label": "%output%",
      "label-background": "${color.grey}"
    },
    "launcher": {
      "type": "custom/text",
      "label": "\"󰣇\"",
      "label-background": "${color.grey}",
      "label-foreground": "${color.fg}",
      "label-font": "4"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-background": "${color.grey}"
    },
    "sept": {
      "type": "custom/text",
      "label": "\" \"",
      "label-background": "${color.trans}"
    },
    "dots": {
      "type": "custom/text",
      "label": "\" 󰇙 \"",
      "label-font": "3",
      "label-foreground": "${color.blue-gray}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.grey}",
      "format-prefix-foreground": "${color.red}",
      "label": "\"%percentage%%\"",
      "label-background": "${color.grey}"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.grey}",
      "format-prefix-foreground": "${color.cyan}",
      "label": "%used%",
      "label-background": "${color.grey}"
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "label-offline": "\"󰝛 No Music\"",
      "format-offline-background": "${color.grey}",
      "format-offline-foreground": "${color.grey}"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\"\"",
      "label-padding": "3pt",
      "label-background": "${color.grey}",
      "label-foreground": "${color.green}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\"\"",
      "label-padding": "3pt",
      "label-background": "${color.grey}",
      "label-foreground": "${color.cyan}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"\"",
      "label-background": "${color.grey}",
      "label-foreground": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.trans}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "3",
      "label": "\"%output%\"",
      "label-background": "${color.grey}"
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-background": "${color.grey}",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-foreground": "${color.purple}",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\"",
      "label-background": "${color.grey}",
      "label-foreground": "${color.purple}",
      "label-padding": "3pt"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
