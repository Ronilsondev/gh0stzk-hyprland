    "blue": "#bd93f9",
    "magenta": "#ff79c6",
    "cyan": "#8be9fd",
    "white": "#f8f8f2",
    "blackb": "#6272a4",
    "redb": "#ff6e6e",
    "greenb": "#69ff94",
    "yellowb": "#ffffa5",
    "blueb": "#d6acff",
    "magentab": "#ff92df",
    "cyanb": "#a4ffff",
    "whiteb": "#ffffff",
    "accent_color": "#2f3240",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "2",
    "TOP_PADDING": "44",
