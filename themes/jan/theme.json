{
  "name": "jan",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#070219",
    "fg": "#27fbfe",
    "black": "#626483",
    "red": "#fb007a",
    "green": "#a6e22e",
    "yellow": "#f3e430",
    "blue": "#19bffe",
    "magenta": "#6800d2",
    "cyan": "#43fbff",
    "white": "#d5ddee",
    "blackb": "#626483",
    "redb": "#fb007a",
    "greenb": "#a6e22e",
    "yellowb": "#f3e430",
    "blueb": "#58AFC2",
    "magentab": "#472575",
    "cyanb": "#926BCA",
    "whiteb": "#d5ddee",
    "accent_color": "#09021f",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "43",
    "BOTTOM_PADDING": "1",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#926BCA",
    "FOCUSED_BC": "#fb007a",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "false",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "0",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "0.96",
    "dunst_offset": "(20, 60)",
    "dunst_origin": "top-right",
    "dunst_transparency": "8",
    "dunst_corner_radius": "0",
    "dunst_font": "Inconsolata Semi Condensed Extra Bold 9",
    "dunst_border": "2",
    "dunst_frame_color": "#6800d2",
    "dunst_icon_theme": "BeautyLine",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "up",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "right",
    "jg_bg": "#070219",
    "jg_fg": "#27fbfe",
    "jg_sel_bg": "#f3e430",
    "jg_sel_fg": "#070219",
    "jg_sep": "#fb007a",
    "rofi_font": "Terminess Nerd Font Mono Bold 10",
    "rofi_background": "#070219F0",
    "rofi_bg_alt": "#09021f",
    "rofi_background_alt": "#070219E0",
    "rofi_fg": "#27fbfe",
    "rofi_selected": "#fb007af0",
    "rofi_active": "#a6e22e",
    "rofi_urgent": "#fb007a",
    "sl_bg": "#070219",
    "sl_fg": "#27fbfe",
    "sl_ring": "#fb007a",
    "sl_wrong": "#fb007a",
    "sl_date": "#f3e430",
    "sl_verify": "#a6e22e",
    "gtk_theme": "CyberPunk-zk",
    "gtk_icons": "BeautyLine",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-CyberPunk",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-01.webp",
  "bar_colors": {
    "bg": "#E6212a4c",
    "fg": "#27fbfe",
    "blue-arch": "#00c9fe",
    "red": "#fb007a",
    "pink": "#f200f4",
    "purple": "#6800d2",
    "blue": "#19bffe",
    "cyan": "#4DD0E1",
    "teal": "#00B19F",
    "green": "#00ff00",
    "lime": "#8df202",
    "yellow": "#f2ed00",
    "amber": "#FBC02D",
    "orange": "#db330a",
    "brown": "#AC8476",
    "grey": "#7a8488",
    "indigo": "#8f32e4",
    "blue-gray": "#1e80d2"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "false",
      "width": "100%",
      "height": "40",
      "offset-x": "0",
      "offset-y": "0",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "0",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-bottom-size": "2",
      "border-color": "${color.purple}",
      "padding-left": "2",
      "padding-right": "2",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"Inconsolata Semi Condensed Extra Bold:size=11;1\"",
      "font-1": "\"Phosphor:size=12;3\"",
      "font-2": "\"Material Design Icons Desktop:size=18;3\"",
      "modules-left": "launcher sep2 sep bspwm",
      "modules-center": "title",
      "modules-right": "colorpicker sep usercard mplayer sep2 bluetooth battery sep filesystem sep cpu_bar sep memory_bar sep network sep pulseaudio sep updates sep2 tray sep date sep power",
      "separator": "\"\"",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "main"
    }
  ],
  "modules": {
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "format-foreground": "${color.fg}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\"\"",
      "format-mounted-prefix-padding": "3pt",
      "format-mounted-prefix-foreground": "${color.orange}",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix": "\"\"",
      "format-unmounted-prefix-padding": "3pt",
      "label-mounted": "\"%used%\"",
      "label-unmounted": "\" %mountpoint%: not mounted\""
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\"祐\"",
      "format-connected-prefix-padding": "3pt",
      "format-connected-foreground": "${color.green}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\"禎\"",
      "format-disconnected-prefix-padding": "3pt",
      "format-disconnected-foreground": "${color.red}",
      "label-connected": "\"%netspeed%\"",
      "label-connected-foreground": "${color.amber}",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-foreground": "${color.red}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"領\"",
      "format-volume-prefix-padding": "3pt",
      "format-volume-foreground": "${color.blue}",
      "label-volume": "\"%percentage%\"",
      "label-volume-foreground": "${color.fg}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "\"尿\"",
      "format-muted-prefix-padding": "3pt",
      "label-muted": "\"Muted\"",
      "label-muted-foreground": "${color.red}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "%percentage%%",
      "label-padding": "3pt",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-foreground": "${color.yellow}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "format-charging-prefix-foreground": "${color.red}",
      "label-charging": "%percentage%%",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "label-discharging": "%percentage%%",
      "format-full": "<label-full>",
      "format-full-prefix": "",
      "format-full-prefix-padding": "3pt",
      "format-full-prefix-foreground": "${color.green}",
      "label-full": "%percentage%%",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-padding": "3pt",
      "ramp-capacity-foreground": "${color.blue}"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\" %output% \""
    },
    "title": {
      "type": "internal/xwindow",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-foreground": "${color.lime}",
      "label": "\"%title%\"",
      "label-maxlen": "45",
      "label-empty": "\" Arch Linux\"",
      "label-empty-foreground": "${color.grey}"
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "label-focused": "[%icon%]",
      "label-focused-background": "${color.bg}",
      "label-focused-foreground": "${color.pink}",
      "label-occupied": "%icon%",
      "label-occupied-background": "${color.bg}",
      "label-occupied-foreground": "${color.lime}",
      "label-urgent": "%icon%",
      "label-urgent-background": "${color.bg}",
      "label-urgent-foreground": "${color.lime}",
      "label-empty": "%icon%",
      "label-empty-background": "${color.bg}",
      "label-empty-foreground": "${color.fg}",
      "label-separator": "\" \""
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\"螺\"",
      "format-prefix-padding": "3pt",
      "format-prefix-foreground": "${color.lime}",
      "label": "%output%"
    },
    "launcher": {
      "type": "custom/text",
      "label": "\"󰣇\"",
      "label-foreground": "${color.blue-arch}"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-padding": "2pt"
    },
    "sep2": {
      "type": "custom/text",
      "label": "\"\"",
      "label-padding": "3pt",
      "label-foreground": "${color.blue-arch}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-padding": "3pt",
      "format-prefix-foreground": "${color.pink}",
      "label": "\"%percentage%%\""
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-padding": "3pt",
      "format-prefix-foreground": "${color.yellow}",
      "label": "\"%used%\""
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.green}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\"飼\"",
      "label-foreground": "${color.cyan}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"累\"",
      "label-foreground": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-foreground": "${color.yellow}",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"珞\"",
      "label-foreground": "${color.pink}"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
