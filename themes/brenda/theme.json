{
  "name": "brenda",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#2d353b",
    "fg": "#d3c6aa",
    "black": "#475258",
    "red": "#e67e80",
    "green": "#a7c080",
    "yellow": "#dbbc7f",
    "blue": "#7fbbb3",
    "magenta": "#d699b6",
    "cyan": "#83c092",
    "white": "#d3c6aa",
    "blackb": "#475258",
    "redb": "#e67e80",
    "greenb": "#a7c080",
    "yellowb": "#dbbc7f",
    "blueb": "#7fbbb3",
    "magentab": "#d699b6",
    "cyanb": "#83c092",
    "whiteb": "#d3c6aa",
    "accent_color": "#272e33",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "48",
    "BOTTOM_PADDING": "1",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#d3c6aa",
    "FOCUSED_BC": "#a7c080",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "true",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "6",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(20, 60)",
    "dunst_origin": "top-right",
    "dunst_transparency": "0",
    "dunst_corner_radius": "6",
    "dunst_font": "JetBrainsMono NF Medium 9",
    "dunst_border": "0",
    "dunst_frame_color": "#a7c080",
    "dunst_icon_theme": "Gruvbox-Plus-Dark",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "right",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "right",
    "jg_bg": "#2d353b",
    "jg_fg": "#d3c6aa",
    "jg_sel_bg": "#475258",
    "jg_sel_fg": "#d3c6aa",
    "jg_sep": "#a7c080",
    "rofi_font": "JetBrainsMono NF Bold 9",
    "rofi_background": "#2d353b",
    "rofi_bg_alt": "#272e33",
    "rofi_background_alt": "#2d353bE0",
    "rofi_fg": "#d3c6aa",
    "rofi_selected": "#7fbbb3",
    "rofi_active": "#a7c080",
    "rofi_urgent": "#e67e80",
    "sl_bg": "#2d353b",
    "sl_fg": "#d3c6aa",
    "sl_ring": "#2d353b",
    "sl_wrong": "#e67e80",
    "sl_date": "#d3c6aa",
    "sl_verify": "#a7c080",
    "gtk_theme": "Everforest-zk",
    "gtk_icons": "Gruvbox-Plus-Dark",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-EverForest",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-02.webp",
  "bar_colors": {
    "bg": "#2d353b",
    "fg": "#d3c6aa",
    "mbg": "#f8f5e4",
    "red": "#e67e80",
    "pink": "#FF0677",
    "purple": "#d699b6",
    "blue": "#7fbbb3",
    "blue-arch": "#0A9CF5",
    "cyan": "#83c092",
    "teal": "#00B19F",
    "green": "#a7c080",
    "lime": "#B9C244",
    "yellow": "#dbbc7f",
    "amber": "#FBC02D",
    "orange": "#e69875",
    "brown": "#AC8476",
    "grey": "#272e33",
    "indigo": "#6C77BB",
    "blue-gray": "#2d353b"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "true",
      "width": "98%",
      "height": "23",
      "offset-x": "1%",
      "offset-y": "5",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "1",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-size": "10px",
      "border-color": "${color.bg}",
      "padding": "1",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"JetBrainsMono:style=Bold:size=9;2\"",
      "font-1": "\"Font Awesome 6 Free Solid:size=10;3\"",
      "font-2": "\"Material Design Icons Desktop:size=11;3\"",
      "font-3": "\"Material Design Icons Desktop:size=12;3\"",
      "modules-left": "launcher bspwm sep cpu_bar sep memory_bar sep filesystem sep mpd_control sep weather",
      "modules-center": "",
      "modules-right": "colorpicker sep bluetooth sep usercard mplayer sep battery sep network sep pulseaudio sep updates sep date sep tray sep power",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "brenda"
    }
  ],
  "modules": {
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "format-background": "${color.mbg}",
      "format-foreground": "${color.blue-gray}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "format-prefix": "",
      "format-prefix-padding": "1",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.blue}",
      "format-prefix-foreground": "${color.blue-gray}",
      "label": "\"%time%%date%\"",
      "label-padding": "1"
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\"\"",
      "format-mounted-prefix-padding": "1",
      "format-mounted-prefix-font": "2",
      "format-mounted-prefix-background": "${color.yellow}",
      "format-mounted-prefix-foreground": "${color.blue-gray}",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix": "\"\"",
      "format-unmounted-prefix-padding": "1",
      "format-unmounted-prefix-font": "2",
      "format-unmounted-prefix-background": "${color.yellow}",
      "format-unmounted-prefix-foreground": "${color.bg}",
      "label-mounted": "%used%",
      "label-mounted-padding": "1",
      "label-mounted-background": "${color.mbg}",
      "label-mounted-foreground": "${color.blue-gray}",
      "label-unmounted": "%mountpoint%: not mounted",
      "label-unmounted-padding": "1",
      "label-unmounted-background": "${color.mbg}",
      "label-unmounted-foreground": "${color.blue-gray}"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\"\"",
      "format-connected-prefix-font": "2",
      "format-connected-prefix-padding": "1",
      "format-connected-prefix-foreground": "${color.blue-gray}",
      "format-connected-prefix-background": "${color.green}",
      "label-connected": "\"%netspeed%\"",
      "label-connected-padding": "1",
      "label-connected-background": "${color.mbg}",
      "label-connected-foreground": "${color.blue-gray}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\"\"",
      "format-disconnected-prefix-font": "2",
      "format-disconnected-prefix-padding": "1",
      "format-disconnected-prefix-background": "${color.green}",
      "format-disconnected-prefix-foreground": "${color.blue-gray}",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-padding": "1",
      "label-disconnected-background": "${color.mbg}",
      "label-disconnected-foreground": "${color.blue-gray}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"\"",
      "format-volume-prefix-font": "2",
      "format-volume-prefix-padding": "1",
      "format-volume-prefix-background": "${color.orange}",
      "format-volume-prefix-foreground": "${color.blue-gray}",
      "label-volume": "\"%percentage%\"",
      "label-volume-padding": "1",
      "label-volume-background": "${color.mbg}",
      "label-volume-foreground": "${color.blue-gray}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "",
      "format-muted-prefix-font": "2",
      "format-muted-prefix-padding": "1",
      "format-muted-prefix-background": "${color.orange}",
      "format-muted-prefix-foreground": "${color.blue-gray}",
      "label-muted": "\"Muted\"",
      "label-muted-padding": "1",
      "label-muted-background": "${color.mbg}",
      "label-muted-foreground": "${color.blue-gray}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "\"%percentage%%\"",
      "label-padding": "1",
      "label-background": "${color.mbg}",
      "label-foreground": "${color.blue-gray}",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-padding": "1",
      "ramp-background": "${color.red}",
      "ramp-foreground": "${color.blue-gray}",
      "ramp-font": "2"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "format-charging-prefix": "\"\"",
      "format-charging-prefix-font": "2",
      "format-charging-prefix-padding": "1",
      "format-charging-prefix-background": "${color.yellow}",
      "format-charging-prefix-foreground": "${color.blue-gray}",
      "label-charging": "\"%percentage%% \"",
      "label-charging-background": "${color.mbg}",
      "label-charging-foreground": "${color.blue-gray}",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "label-discharging-padding": "1",
      "label-discharging-background": "${color.mbg}",
      "label-discharging-foreground": "${color.blue-gray}",
      "label-discharging": "\"%percentage%%\"",
      "format-full": "<label-full>",
      "format-full-prefix": "\"\"",
      "format-full-prefix-font": "2",
      "format-full-prefix-padding": "1",
      "format-full-prefix-background": "${color.green}",
      "format-full-prefix-foreground": "${color.blue-gray}",
      "label-full": "\"%percentage%%\"",
      "label-full-padding": "1",
      "label-full-background": "${color.mbg}",
      "label-full-foreground": "${color.blue-gray}",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-foreground": "${color.blue-gray}",
      "ramp-capacity-background": "${color.blue}",
      "ramp-capacity-padding": "1",
      "ramp-capacity-font": "2"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\"%output%\""
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-background": "${color.mbg}",
      "format-font": "3",
      "label-focused": "󰮯",
      "label-focused-padding": "1",
      "label-focused-foreground": "${color.orange}",
      "label-occupied": "󰊠",
      "label-occupied-padding": "1",
      "label-occupied-foreground": "${color.purple}",
      "label-urgent": "󰊠",
      "label-urgent-padding": "1",
      "label-urgent-foreground": "${color.purple}",
      "label-empty": "󰑊",
      "label-empty-padding": "1",
      "label-empty-foreground": "${color.blue-gray}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-font": "2",
      "format-prefix-padding": "1",
      "format-prefix-background": "${color.lime}",
      "format-prefix-foreground": "${color.blue-gray}",
      "label": "%output%",
      "label-padding": "1",
      "label-background": "${color.mbg}",
      "label-foreground": "${color.blue-gray}"
    },
    "launcher": {
      "type": "custom/text",
      "label": "󰣇",
      "label-foreground": "${color.blue-gray}",
      "label-background": "${color.green}",
      "label-padding": "1",
      "label-font": "4"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.bg}"
    },
    "dots": {
      "type": "custom/text",
      "label": "\" 󰇙 \"",
      "label-font": "3",
      "label-foreground": "${color.blue-gray}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-padding": "1",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.red}",
      "format-prefix-foreground": "${color.blue-gray}",
      "label": "\"%percentage%%\"",
      "label-padding": "1",
      "label-background": "${color.mbg}",
      "label-foreground": "${color.blue-gray}"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-padding": "1",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.blue}",
      "format-prefix-foreground": "${color.blue-gray}",
      "label": "%used%",
      "label-padding": "1",
      "label-background": "${color.mbg}",
      "label-foreground": "${color.blue-gray}"
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next><label-song>",
      "format-online-background": "${color.purple}",
      "label-song": "\"%title%\"",
      "label-song-font": "1",
      "label-song-padding": "1",
      "label-song-maxlen": "18",
      "label-song-background": "${color.mbg}",
      "label-song-foreground": "${color.blue-gray}",
      "format-offline": "<label-offline>",
      "label-offline": "\"󰝛 No Music\"",
      "label-offline-padding": "1",
      "format-offline-background": "${color.mbg}",
      "format-offline-foreground": "${color.blue-gray}"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.blue-gray}",
      "label-background": "${color.purple}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\"\"",
      "label-padding": "1",
      "label-foreground": "${color.blue-gray}",
      "label-background": "${color.purple}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"\"",
      "label-padding": "1",
      "label-foreground": "${color.mbg}",
      "label-background": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "3",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-background": "${color.mc}",
      "format-prefix": "\"\"",
      "format-prefix-font": "2",
      "format-prefix-padding": "1",
      "format-prefix-background": "${color.red}",
      "format-prefix-foreground": "${color.blue-gray}",
      "label-layout": "%layout%",
      "label-layout-padding": "1",
      "label-layout-foreground": "${color.blue-gray}",
      "label-layout-background": "${color.mbg}"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\""
    }
  },
  "status": "migrado; teste gráfico pendente"
}
