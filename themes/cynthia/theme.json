    "sl_wrong": "#c4746e",
    "sl_date": "#181616",
    "sl_verify": "#8a9a7b",
    "gtk_theme": "KanagawaDragon-zk",
    "gtk_icons": "Gruvbox-Plus-Dark",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-KanagawaDragon",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-06.webp",
  "bar_colors": {
    "bg": "#181616",
    "bg-alt": "#708491",
    "fg": "#c5c9c5",
    "mb": "#242121",
    "red": "#E46876",
    "pink": "#EC407A",
    "purple": "#938AA9",
    "blue": "#7FB4CA",
    "cyan": "#7AA89F",
    "teal": "#00B19F",
    "green": "#87a987",
    "lime": "#B9C244",
    "yellow": "#E6C384",
    "amber": "#FBC02D",
    "orange": "#E57C46",
    "brown": "#AC8476",
    "grey": "#8C8C8C",
    "indigo": "#6C77BB",
    "blue-gray": "#6D8895"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "false",
      "width": "100%",
      "height": "30",
      "offset-x": "0",
      "offset-y": "0",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "0",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-size": "8",
      "border-color": "${color.bg}",
      "padding-left": "1",
      "padding-right": "1",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"JetBrainsMono:style=Regular:size=9;2\"",
      "font-1": "\"Material Design Icons Desktop:size=13;3\"",
      "font-2": "\"Material Design Icons Desktop:size=16;4\"",
      "font-3": "\"MesloLGS NF:style=Regular:size=17;4\"",
      "modules-left": "launcher sep2 browser filem terminal editor whats fetch",
      "modules-center": "bi bspwm bd",
      "modules-right": "tray sep bi filesystem cpu_bar memory_bar bd sep bi network bd sep power",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "cyn-bar"
    },
    {
      "override-redirect": "false",
      "bottom": "true",
      "fixed-center": "true",
      "width": "100%",
      "height": "30",
      "offset-x": "0",
      "offset-y": "0",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "0",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-size": "8",
      "border-color": "${color.bg}",
      "padding-left": "1",
      "padding-right": "1",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"JetBrainsMono:style=Regular:size=9;3\"",
      "font-1": "\"Material Design Icons Desktop:size=13;4\"",
      "font-2": "\"Font Awesome 6 Free Solid:size=10;3\"",
      "font-3": "\"MesloLGS NF:style=Regular:size=17;4\"",
      "modules-left": "title",
      "modules-center": "mpd_control sep mpd",
      "modules-right": "bluetooth sep brightness sep usercard sep mplayer sep battery sep mod sep weather sep bi pulseaudio bd sep bi updates bd sep date",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "cyn-bar2"
    }
  ],
  "modules": {
    "bi": {
      "type": "custom/text",
      "label": "\"%{T4}%{T-}\"",
      "label-foreground": "${color.mb}",
      "label-background": "${color.bg}"
    },
    "bd": {
      "type": "custom/text",
      "label": "\"%{T4}%{T-}\"",
      "label-foreground": "${color.mb}",
      "label-background": "${color.bg}"
    },
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "format-foreground": "${color.fg}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\"Disk: \"",
      "format-mounted-prefix-foreground": "${color.purple}",
      "format-mounted-prefix-background": "${color.mb}",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix": "\"Disk: \"",
      "label-mounted": "\"%used%  \"",
      "label-mounted-background": "${color.mb}",
      "label-unmounted": "%mountpoint%: not mounted",
      "label-unmounted-background": "${color.mb}"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\"NET: \"",
      "format-connected-background": "${color.mb}",
      "format-connected-foreground": "${color.green}",
      "label-connected": "\"%netspeed%\"",
      "label-connected-background": "${color.mb}",
      "label-connected-foreground": "${color.yellow}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\"NET: \"",
      "format-disconnected-background": "${color.mb}",
      "format-disconnected-foreground": "${color.red}",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-background": "${color.mb}",
      "label-disconnected-foreground": "${color.red}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"VOL: \"",
      "format-volume-background": "${color.mb}",
      "format-volume-foreground": "${color.indigo}",
      "label-volume": "\"%percentage%%\"",
      "label-volume-background": "${color.mb}",
      "label-volume-foreground": "${color.fg}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "󰝟",
      "format-muted-background": "${color.mb}",
      "label-muted": "\" Muted\"",
      "label-muted-background": "${color.mb}",
      "label-muted-foreground": "${color.red}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "\"%percentage%% \"",
      "ramp-0": "󰃚",
      "ramp-1": "󰃚",
      "ramp-2": "󰃝",
      "ramp-3": "󰃝",
      "ramp-4": "󰃟",
      "ramp-5": "󰃟",
      "ramp-6": "󰃠",
      "ramp-7": "󰃠",
      "ramp-font": "2",
      "ramp-padding": "3pt",
      "ramp-foreground": "${color.yellow}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "format-charging-prefix-foreground": "${color.red}",
      "label-charging": "%percentage%%",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "label-discharging": "%percentage%%",
      "format-full": "<label-full>",
      "format-full-prefix": "",
      "format-full-prefix-font": "5",
      "format-full-prefix-padding": "3 pt",
      "format-full-prefix-foreground": "${color.green}",
      "label-full": "\"%percentage%%\"",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-foreground": "${color.yellow}",
      "ramp-capacity-font": "5",
      "ramp-capacity-padding": "3 pt"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\"%output%\""
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-font": "3",
      "label-focused": "%icon%",
      "label-focused-background": "${color.mb}",
      "label-focused-padding": "1",
      "label-focused-foreground": "${color.blue}",
      "label-occupied": "%icon%",
      "label-occupied-padding": "1",
      "label-occupied-background": "${color.mb}",
      "label-occupied-foreground": "${color.green}",
      "label-urgent": "%icon%",
      "label-urgent-padding": "1",
      "label-urgent-background": "${color.mb}",
      "label-urgent-foreground": "${color.green}",
      "label-empty": "%icon%",
      "label-empty-foreground": "${color.fg}",
      "label-empty-padding": "1",
      "label-empty-background": "${color.mb}"
    },
    "mod": {
      "type": "internal/bspwm",
      "format": "<label-mode>",
      "format-background": "${color.bg}",
      "format-foreground": "${color.purple}",
      "format-padding": "1",
      "format-font": "1",
      "label-monocle": "\"Monocle\"",
      "label-tiled": "\"Tiled\"",
      "label-floating": "\" | Float\"",
      "label-pseudotiled": "\" | Pseudo\"",
      "label-fullscreen": "\" | Full\"",
      "label-locked": "\" | Locked\"",
      "label-sticky": "\" | Sticky\"",
      "label-private": "\" | Private\""
    },
    "browser": {
      "type": "custom/text",
      "label": "\"󰇧\"",
      "label-padding": "1",
      "label-background": "${color.bg}",
      "label-foreground": "${color.orange}"
    },
    "filem": {
      "type": "custom/text",
      "label": "\"󰷏\"",
      "label-padding": "1",
      "label-background": "${color.bg}",
      "label-foreground": "${color.yellow}"
    },
    "terminal": {
      "type": "custom/text",
      "label": "\"󰆍\"",
      "label-padding": "1",
      "label-background": "${color.bg}",
      "label-foreground": "${color.blue}"
    },
    "editor": {
      "type": "custom/text",
      "label": "\"󱞂\"",
      "label-padding": "1",
      "label-background": "${color.bg}",
      "label-foreground": "${color.red}"
    },
    "whats": {
      "type": "custom/text",
      "label": "\"󰖣\"",
      "label-padding": "1",
      "label-background": "${color.bg}",
      "label-foreground": "${color.green}"
    },
    "fetch": {
      "type": "custom/text",
      "label": "\"󰯇\"",
      "label-padding": "1",
      "label-background": "${color.bg}",
      "label-foreground": "${color.pink}"
    },
    "title": {
      "type": "internal/xwindow",
      "format": "<label>",
      "format-prefix": "\"󱂬 \"",
      "format-prefix-foreground": "${color.purple}",
      "format-prefix-font": "2",
      "label": "%title%",
      "label-maxlen": "45",
      "label-empty": "\"Arch Linux\"",
      "label-empty-foreground": "${color.grey}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\"󰑖 \"",
      "format-prefix-foreground": "${color.green}",
      "format-prefix-background": "${color.mb}",
      "label": "%output%",
      "label-background": "${color.mb}"
    },
    "launcher": {
      "type": "custom/text",
      "label": "󰣇",
      "label-font": "3",
      "label-foreground": "${color.fg}"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.bg-alt}"
    },
    "sep2": {
      "type": "custom/text",
      "label": "\" 󰇙 \"",
      "label-foreground": "${color.indigo}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\"CPU: \"",
      "format-prefix-background": "${color.mb}",
      "format-prefix-foreground": "${color.red}",
      "label": "\"%percentage%%  \"",
      "label-background": "${color.mb}"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\"RAM: \"",
      "format-prefix-background": "${color.mb}",
      "format-prefix-foreground": "${color.yellow}",
      "label": "\"%used% \"",
      "label-background": "${color.mb}"
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "label-offline": "\"󰝛 No Music\"",
      "format-offline-foreground": "${color.grey}"
    },
    "mpd": {
      "type": "internal/mpd",
      "format-online": "\"%{F#87a987}[%{F-} <label-song> %{F#87a987}]%{F-}\"",
      "format-offline": "\"\"",
      "label-song": "\"%title%\"",
      "label-song-maxlen": "40"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.green}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.cyan}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"󰐥\"",
      "label-foreground": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "2",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-foreground": "${color.cyan}",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"󰏘\"",
      "label-foreground": "${color.green}"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
