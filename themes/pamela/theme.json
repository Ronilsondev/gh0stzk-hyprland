  "modules": {
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "format-foreground": "${color.fg}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\"\"",
      "format-mounted-prefix-padding": "3pt",
      "format-mounted-prefix-foreground": "${color.purple}",
      "label-mounted": "\"%used%\"",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix": "\"\"",
      "format-unmounted-prefix-padding": "3pt",
      "label-unmounted": "%mountpoint%: not mounted"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\"\"",
      "format-connected-prefix-padding": "3pt",
      "format-connected-foreground": "${color.green}",
      "label-connected": "\"%netspeed%\"",
      "label-connected-foreground": "${color.amber}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\"\"",
      "format-disconnected-prefix-padding": "3pt",
      "format-disconnected-foreground": "${color.red}",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-foreground": "${color.red}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"\"",
      "format-volume-prefix-padding": "3pt",
      "format-volume-foreground": "${color.indigo}",
      "label-volume": "\"%percentage%\"",
      "label-volume-foreground": "${color.fg}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "\"\"",
      "format-muted-prefix-padding": "3pt",
      "format-muted-foreground": "${color.indigo}",
      "label-muted": "\"Muted\"",
      "label-muted-foreground": "${color.red}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "%percentage%%",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-3": "",
      "ramp-4": "",
      "ramp-padding": "3pt",
      "ramp-foreground": "${color.amber}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "format-charging-background": "${color.bg-alt}",
      "label-charging": "%percentage%%",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "format-discharging-background": "${color.bg-alt}",
      "label-discharging": "%percentage%%",
      "format-full": "<label-full>",
      "format-full-background": "${color.bg-alt}",
      "format-full-prefix": "",
      "format-full-prefix-padding-right": "3pt",
      "format-full-prefix-background": "${color.bg-alt}",
      "format-full-prefix-font": "2",
      "format-full-prefix-foreground": "${color.green}",
      "label-full": "%percentage%%",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-foreground": "${color.green}",
      "ramp-capacity-font": "2",
      "ramp-capacity-padding-right": "3pt"
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "label-focused": "󰮯",
      "label-focused-padding": "1",
      "label-focused-foreground": "${color.yellow}",
      "label-occupied": "󰊠",
      "label-occupied-padding": "1",
      "label-occupied-foreground": "${color.blue}",
      "label-urgent": "󰊠",
      "label-urgent-padding": "1",
      "label-urgent-foreground": "${color.blue}",
      "label-empty": "󰑊",
      "label-empty-padding": "1",
      "label-empty-foreground": "${color.grey}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-foreground": "${color.lime}",
      "label": "%output%"
    },
    "launcher": {
      "type": "custom/text",
      "label": "\"󰣇\"",
      "label-foreground": "${color.blue}"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\"  \"",
      "label-foreground": "${color.green}"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.bg-alt}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-padding": "3pt",
      "format-prefix-foreground": "${color.pink}",
      "label": "\"%percentage%%\""
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-padding": "3pt",
      "format-prefix-foreground": "${color.amber}",
      "label": "\"%used%\""
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "format-offline-foreground": "${color.grey}",
      "label-offline": "\" No Music\""
    },
    "mpd": {
      "type": "internal/mpd",
      "format-online": "\"%{F#9ece6a}[%{F-} <label-song> %{F#9ece6a}]%{F-}\"",
      "format-offline": "\" No Music\"",
      "format-offline-foreground": "${color.grey}",
      "label-song": "\"%title% - %artist%\"",
      "label-song-maxlen": "25"
    },
    "r00t": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.cyan}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.red}"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\"%output%\"",
      "label-background": "${color.bg-alt}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg-alt}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "3",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-foreground": "${color.cyan}",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.green}"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
