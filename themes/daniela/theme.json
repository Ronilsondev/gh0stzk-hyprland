{
  "name": "daniela",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#181825",
    "fg": "#CDD6F4",
    "black": "#45475A",
    "red": "#F38BA8",
    "green": "#A6E3A1",
    "yellow": "#F9E2AF",
    "blue": "#89B4FA",
    "magenta": "#F5C2E7",
    "cyan": "#94E2D5",
    "white": "#BAC2DE",
    "blackb": "#585B70",
    "redb": "#F38BA8",
    "greenb": "#A6E3A1",
    "yellowb": "#F9E2AF",
    "blueb": "#89B4FA",
    "magentab": "#F5C2E7",
    "cyanb": "#94E2D5",
    "whiteb": "#A6ADC8",
    "accent_color": "#1e1e2e",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "46",
    "BOTTOM_PADDING": "1",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#45475A",
    "FOCUSED_BC": "#94E2D5",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "true",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "6",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(20, 60)",
    "dunst_origin": "top-right",
    "dunst_transparency": "0",
    "dunst_corner_radius": "6",
    "dunst_font": "JetBrainsMono NF Medium 9",
    "dunst_border": "0",
    "dunst_frame_color": "#A6ADC8",
    "dunst_icon_theme": "Catppuccin-Mocha",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "up",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "up",
    "jg_bg": "#181825",
    "jg_fg": "#CDD6F4",
    "jg_sel_bg": "#F5C2E7",
    "jg_sel_fg": "#181825",
    "jg_sep": "#45475A",
    "rofi_font": "JetBrainsMono NF Bold 9",
    "rofi_background": "#181825",
    "rofi_bg_alt": "#1e1e2e",
    "rofi_background_alt": "#181825E0",
    "rofi_fg": "#CDD6F4",
    "rofi_selected": "#F5C2E7",
    "rofi_active": "#A6E3A1",
    "rofi_urgent": "#F38BA8",
    "sl_bg": "#181825",
    "sl_fg": "#CDD6F4",
    "sl_ring": "#F5C2E7",
    "sl_wrong": "#F38BA8",
    "sl_date": "#CDD6F4",
    "sl_verify": "#A6E3A1",
    "gtk_theme": "CatppuccinMocha-zk",
    "gtk_icons": "Catppuccin-Mocha",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-CatppuccinMocha",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-02.webp",
  "bar_colors": {
    "bg": "#181825",
    "fg": "#cdd6f4",
    "red": "#f38ba8",
    "pink": "#f5c2e7",
    "purple": "#cba6f7",
    "blue": "#89b4fa",
    "blue-arch": "#0A9CF5",
    "cyan": "#94e2d5",
    "green": "#a6e3a1",
    "yellow": "#f9e2af",
    "lavander": "#b4befe",
    "amber": "#FBC02D",
    "orange": "#fab387",
    "brown": "#f2cdcd",
    "grey": "#73739c",
    "indigo": "#9399b2",
    "blue-gray": "#383857"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "true",
      "width": "100%",
      "height": "45",
      "offset-x": "0",
      "offset-y": "0",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "0",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border": "0",
      "border-color": "${color.pink}",
      "padding": "4",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"Bebas Neue:style=Regular:size=13;3\"",
      "font-1": "\"Font Awesome 6 Free Solid:size=9;2\"",
      "font-2": "\"Bebas Neue:style=Regular:size=15;3\"",
      "font-3": "\"Material Design Icons Desktop:size=17;4\"",
      "font-4": "\"Bebas Neue:style=Regular:size=12;3\"",
      "font-5": "\"Material Design Icons Desktop:size=11;2\"",
      "modules-left": "launcher sep sep cpu_bar sep memory_bar sep filesystem sep weather sep tray",
      "modules-center": "bspwm",
      "modules-right": "colorpicker sep mplayer usercard power bluetooth sep mpd_control sep battery sep network sep pulseaudio sep updates sep date",
      "separator": "\"  \"",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "dani"
    }
  ],
  "modules": {
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "format-foreground": "${color.orange}",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\"DISK\"",
      "format-mounted-prefix-font": "1",
      "format-mounted-prefix-foreground": "${color.red}",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix-font": "1",
      "format-unmounted-prefix": "\"DISK\"",
      "label-mounted": "%used%",
      "label-mounted-padding": "2pt",
      "label-mounted-font": "5",
      "label-unmounted": "%mountpoint%: not mounted",
      "label-unmounted-padding": "2pt",
      "label-unmounted-font": "5"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\"NET\"",
      "format-connected-prefix-foreground": "${color.green}",
      "format-connected-prefix-font": "1",
      "label-connected": "\"%netspeed%\"",
      "label-connected-padding": "2pt",
      "label-connected-font": "5",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\"NET\"",
      "format-disconnected-prefix-font": "1",
      "format-disconnected-prefix-foreground": "${color.red}",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-padding": "2pt",
      "label-disconnected-font": "5"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"VOL\"",
      "format-volume-prefix-font": "1",
      "format-volume-prefix-foreground": "${color.lavander}",
      "label-volume": "\"%percentage%\"",
      "label-volume-padding": "2pt",
      "label-volume-font": "5",
      "format-muted": "<label-muted>",
      "label-muted": "\"Muted\"",
      "label-muted-padding": "2pt",
      "label-muted-font": "1",
      "label-muted-foreground": "${color.red}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "%percentage%%",
      "label-padding": "2pt",
      "label-font": "5",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "2",
      "ramp-foreground": "${color.yellow}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "label-charging": "%percentage%%",
      "label-charging-padding": "2pt",
      "label-charging-font": "5",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "label-discharging": "%percentage%%",
      "label-discharging-font": "5",
      "label-discharging-padding": "2pt",
      "format-full": "<label-full>",
      "format-full-prefix": "",
      "format-full-prefix-font": "2",
      "format-full-prefix-foreground": "${color.green}",
      "label-full": "%percentage%%",
      "label-full-padding": "2pt",
      "label-full-font": "5",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-foreground": "${color.purple}",
      "ramp-capacity-font": "2"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\"%output%\"",
      "label-font": "5"
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-font": "1",
      "label-focused": "%icon%",
      "label-focused-font": "3",
      "label-focused-padding": "3",
      "label-focused-foreground": "${color.purple}",
      "label-occupied": "%icon%",
      "label-occupied-padding": "3",
      "label-occupied-foreground": "${color.grey}",
      "label-urgent": "%icon%",
      "label-urgent-padding": "3",
      "label-urgent-foreground": "${color.grey}",
      "label-empty": "%icon%",
      "label-empty-padding": "3",
      "label-empty-foreground": "${color.blue-gray}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\"UPDATES\"",
      "format-prefix-font": "1",
      "format-prefix-foreground": "${color.purple}",
      "label": "%output%",
      "label-padding": "2pt",
      "label-font": "5"
    },
    "launcher": {
      "type": "custom/text",
      "format-prefix": "\"󰣇\"",
      "format-prefix-font": "4",
      "format-prefix-foreground": "${color.green}",
      "label": "\"Arch\"",
      "label-font": "1"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.bg}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\"CPU\"",
      "format-prefix-font": "1",
      "format-prefix-foreground": "${color.blue}",
      "label": "\"%percentage%%\"",
      "label-padding": "2pt",
      "label-font": "5"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\"RAM\"",
      "format-prefix-font": "1",
      "format-prefix-foreground": "${color.yellow}",
      "label": "%used%",
      "label-padding": "2pt",
      "label-font": "5"
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "label-offline": "\" No Music\"",
      "format-offline-foreground": "${color.grey}"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\"\"",
      "label-padding": "2pt",
      "label-foreground": "${color.purple}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\"\"",
      "label-padding": "2pt",
      "label-foreground": "${color.cyan}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"\"",
      "label-padding": "2pt",
      "label-foreground": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "6",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\"KB\"",
      "format-prefix-font": "1",
      "format-prefix-foreground": "${color.cyan}",
      "label-layout": "%layout%",
      "label-layout-padding": "2pt",
      "label-layout-font": "5"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.yellow}"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
