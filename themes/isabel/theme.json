{
  "name": "isabel",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#14171c",
    "fg": "#abb2bf",
    "black": "#181b21",
    "red": "#be5046",
    "green": "#81ae5f",
    "yellow": "#d19a66",
    "blue": "#4889be",
    "magenta": "#7560d3",
    "cyan": "#49919a",
    "white": "#abb2bf",
    "blackb": "#5c6370",
    "redb": "#e06c75",
    "greenb": "#98c379",
    "yellowb": "#e5c07b",
    "blueb": "#61afef",
    "magentab": "#8677cf",
    "cyanb": "#56b6c2",
    "whiteb": "#b8bfe5",
    "accent_color": "#181b21",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "1",
    "BOTTOM_PADDING": "40",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#b8bfe5",
    "FOCUSED_BC": "#7560d3",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "true",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "6",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(0, 10)",
    "dunst_origin": "top-center",
    "dunst_transparency": "0",
    "dunst_corner_radius": "6",
    "dunst_font": "Inconsolata Semi Condensed Bold 9",
    "dunst_border": "0",
    "dunst_frame_color": "#8677cf",
    "dunst_icon_theme": "Zafiro-Purple",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "up",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "up",
    "jg_bg": "#14171c",
    "jg_fg": "#abb2bf",
    "jg_sel_bg": "#181b21",
    "jg_sel_fg": "#b8bfe5",
    "jg_sep": "#5c6370",
    "rofi_font": "Terminess Nerd Font Mono Bold 10",
    "rofi_background": "#14171c",
    "rofi_bg_alt": "#181b21",
    "rofi_background_alt": "#14171cE0",
    "rofi_fg": "#abb2bf",
    "rofi_selected": "#8677cf",
    "rofi_active": "#81ae5f",
    "rofi_urgent": "#e06c75",
    "sl_bg": "#14171c",
    "sl_fg": "#abb2bf",
    "sl_ring": "#14171c",
    "sl_wrong": "#be5046",
    "sl_date": "#abb2bf",
    "sl_verify": "#81ae5f",
    "gtk_theme": "OneDark-zk",
    "gtk_icons": "Zafiro-Purple",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-OneDark",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-04.webp",
  "bar_colors": {
    "bg": "#14171c",
    "bg-alt": "#708491",
    "fg": "#abb2bf",
    "red": "#be5046",
    "pink": "#dc5bbc",
    "purple": "#7560d3",
    "blue": "#4889be",
    "cyan": "#49919a",
    "teal": "#00B19F",
    "green": "#81ae5f",
    "lime": "#B9C244",
    "yellow": "#d19a66",
    "amber": "#fac33b",
    "orange": "#de8658",
    "brown": "#AC8476",
    "grey": "#8C8C8C",
    "indigo": "#6C77BB",
    "blue-gray": "#6D8895"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "true",
      "fixed-center": "false",
      "width": "100%",
      "height": "40",
      "offset-x": "0",
      "offset-y": "0",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "0",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-size": "0",
      "border-color": "${color.bg}",
      "padding-left": "2",
      "padding-right": "2",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"Inconsolata Semi Condensed Bold:size=11;2\"",
      "font-1": "\"Material Design Icons Desktop:size=16;4\"",
      "font-2": "\"Material Design Icons Desktop:size=12;3\"",
      "font-3": "\"Font Awesome 6 Free Solid:size=10;3\"",
      "modules-left": "launcher sep2 bspwm sep2 usercard sep mplayer weather sep colorpicker",
      "modules-center": "title",
      "modules-right": "mpd_control sep2 bluetooth sep battery sep updates sep filesystem sep cpu_bar sep memory_bar sep pulseaudio sep network sep2 tray sep date sep power",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "isa-bar"
    }
  ],
  "modules": {
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "format-foreground": "${color.fg}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "format-prefix-foreground": "${color.blue}",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\" \"",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix": "\" \"",
      "label-mounted": "\"%used% \"",
      "label-mounted-foreground": "${color.grey}",
      "label-unmounted": "%mountpoint%: not mounted"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\"  \"",
      "label-connected": "\"%netspeed%\"",
      "label-connected-foreground": "${color.grey}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\"  \"",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-foreground": "${color.red}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<ramp-volume><label-volume>",
      "format-volume-prefix": "\"\"",
      "label-volume": "\" %percentage%\"",
      "label-volume-foreground": "${color.grey}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "\" \"",
      "label-muted": "\"Muted\"",
      "label-muted-foreground": "${color.red}",
      "ramp-volume-0": "",
      "ramp-volume-1": "",
      "ramp-volume-2": "",
      "ramp-volume-3": "",
      "ramp-volume-4": ""
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "\"%percentage%%\"",
      "label-padding": "3pt",
      "label-foreground": "${color.grey}",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "4"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "label-charging": "%percentage%%",
      "label-charging-foreground": "${color.grey}",
      "label-charging-padding": "3pt",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "label-discharging": "%percentage%%",
      "label-discharging-foreground": "${color.grey}",
      "label-discharging-padding": "3pt",
      "format-full": "<label-full>",
      "format-full-prefix": "",
      "format-full-prefix-font": "4",
      "label-full": "%percentage%%",
      "label-full-foreground": "${color.grey}",
      "label-full-padding": "3pt",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-font": "4"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\" %output%\""
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-font": "3",
      "label-focused": "󰮯",
      "label-focused-padding": "1",
      "label-focused-foreground": "${color.fg}",
      "label-focused-font": "3",
      "label-occupied": "󰊠",
      "label-occupied-padding": "1",
      "label-occupied-foreground": "${color.fg}",
      "label-occupied-font": "3",
      "label-urgent": "󰊠",
      "label-urgent-padding": "1",
      "label-urgent-foreground": "${color.fg}",
      "label-urgent-font": "3",
      "label-empty": "󰑊",
      "label-empty-padding": "1",
      "label-empty-foreground": "${color.grey}",
      "label-empty-font": "3"
    },
    "title": {
      "type": "internal/xwindow",
      "format": "<label>",
      "format-prefix": "\"󱂬 \"",
      "format-prefix-font": "3",
      "format-prefix-foreground": "${color.purple}",
      "label": "%title%",
      "label-maxlen": "35",
      "label-empty": "\"Arch Linux\"",
      "label-empty-foreground": "${color.grey}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\" \"",
      "label": "\"%output% \"",
      "label-foreground": "${color.grey}"
    },
    "launcher": {
      "type": "custom/text",
      "label": "󰣇",
      "label-font": "2",
      "label-foreground": "${color.fg}"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.bg-alt}"
    },
    "sep2": {
      "type": "custom/text",
      "label": "\" 󰇙 \"",
      "label-foreground": "${color.indigo}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\" \"",
      "label": "\"%percentage%% \"",
      "label-foreground": "${color.grey}"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\" \"",
      "label": "\"%used% \"",
      "label-foreground": "${color.grey}"
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "label-offline": "\"󰝛 No Music\"",
      "format-offline-foreground": "${color.grey}"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.green}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.cyan}"
    },
    "power": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "3",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "label-layout": "\"%layout% \"",
      "label-layout-foreground": "${color.grey}"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\""
    }
  },
  "status": "migrado; teste gráfico pendente"
}
