{
  "name": "yael",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#161616",
    "fg": "#ffffff",
    "black": "#262626",
    "red": "#ee5396",
    "green": "#42be65",
    "yellow": "#ffe97b",
    "blue": "#33b1ff",
    "magenta": "#ff7eb6",
    "cyan": "#3ddbd9",
    "white": "#dde1e6",
    "blackb": "#393939",
    "redb": "#ee5396",
    "greenb": "#42be65",
    "yellowb": "#ffe97b",
    "blueb": "#33b1ff",
    "magentab": "#ff7eb6",
    "cyanb": "#3ddbd9",
    "whiteb": "#ffffff",
    "accent_color": "#212121",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "37",
    "BOTTOM_PADDING": "1",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#33b1ff",
    "FOCUSED_BC": "#42be65",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "true",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "6",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(20, 20)",
    "dunst_origin": "bottom-right",
    "dunst_transparency": "0",
    "dunst_corner_radius": "6",
    "dunst_font": "JetBrainsMono NF Medium 9",
    "dunst_border": "0",
    "dunst_frame_color": "#33b1ff",
    "dunst_icon_theme": "Candy",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "down",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "down",
    "jg_bg": "#161616",
    "jg_fg": "#ffffff",
    "jg_sel_bg": "#33b1ff",
    "jg_sel_fg": "#161616",
    "jg_sep": "#ee5396",
    "rofi_font": "JetBrainsMono NF Bold 9",
    "rofi_background": "#161616",
    "rofi_bg_alt": "#212121",
    "rofi_background_alt": "#161616E0",
    "rofi_fg": "#ffffff",
    "rofi_selected": "#33b1ff",
    "rofi_active": "#42be65",
    "rofi_urgent": "#ee5396",
    "sl_bg": "#161616",
    "sl_fg": "#33b1ff",
    "sl_ring": "#161616",
    "sl_wrong": "#ee5396",
    "sl_date": "#ff7eb6",
    "sl_verify": "#42be65",
    "gtk_theme": "OxoCarbon-zk",
    "gtk_icons": "Glassy",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-OxoCarbon",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-01.webp",
  "bar_colors": {
    "bg": "#161616",
    "fg": "#ffffff",
    "red": "#ee5396",
    "pink": "#FF0677",
    "purple": "#ff7eb6",
    "blue": "#33b1ff",
    "blue-arch": "#0A9CF5",
    "cyan": "#3ddbd9",
    "teal": "#00B19F",
    "green": "#42be65",
    "lime": "#B9C244",
    "yellow": "#ffe97b",
    "amber": "#FBC02D",
    "orange": "#E57C46",
    "brown": "#AC8476",
    "grey": "#8C8C8C",
    "indigo": "#82CFFF",
    "blue-gray": "#43789C"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "false",
      "width": "98%",
      "height": "32",
      "offset-x": "1%",
      "offset-y": "5",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "5",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border": "0",
      "border-color": "${color.bg}",
      "padding": "0",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"JetBrainsMono:style=ExtraBold:size=9;3\"",
      "font-1": "\"Font Awesome 6 Free Solid:size=11;3\"",
      "font-2": "\"Material Design Icons Desktop:size=14;3\"",
      "font-3": "\"Font Awesome 6 Free Solid:size=9;3\"",
      "modules-left": "launcher sep sep bspwm",
      "modules-center": "title",
      "modules-right": "colorpicker mpd sep sep mpd_control sep sep pulseaudio sep bluetooth sep battery sep sep filesystem sep sep memory_bar sep sep cpu_bar sep sep network sep sep mplayer usercard sep sep updates sep sep power sep sep tray sep sep date",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "yael-cohen"
    }
  ],
  "modules": {
    "date": {
      "type": "internal/date",
      "time": "\"%I:%M %P \"",
      "format-background": "${color.blue}",
      "format-foreground": "${color.bg}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "format-font": "2",
      "label": "\" %time%%date% \"",
      "label-font": "1"
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\" \"",
      "format-mounted-prefix-foreground": "${color.blue}",
      "format-mounted-prefix-font": "4",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix-font": "4",
      "format-unmounted-prefix": "\" \"",
      "format-unmounted-prefix-foreground": "${color.blue}",
      "label-mounted": "\"%used%\"",
      "label-unmounted": "\"%mountpoint%: not mounted\""
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "label-connected": "\"\"",
      "label-connected-font": "4",
      "label-connected-foreground": "${color.blue}",
      "format-disconnected": "<label-disconnected>",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-foreground": "${color.red}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<ramp-volume> <bar-volume>",
      "format-volume-foreground": "${color.blue}",
      "label-volume": "\"%percentage%\"",
      "label-volume-foreground": "${color.fg}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "\" \"",
      "format-muted-prefix-font": "4",
      "format-muted-foreground": "${color.blue}",
      "label-muted": "\"Muted\"",
      "label-muted-foreground": "${color.red}",
      "ramp-volume-0": "",
      "ramp-volume-1": "",
      "ramp-volume-2": "",
      "ramp-volume-3": "",
      "ramp-volume-4": "",
      "ramp-volume-font": "4"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "%percentage%%",
      "label-padding-left": "3pt",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "4",
      "ramp-foreground": "${color.yellow}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "label-charging": "%percentage%%",
      "label-charging-padding-left": "3pt",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "label-discharging": "%percentage%%",
      "label-discharging-padding-left": "3pt",
      "format-full": "<label-full>",
      "format-full-prefix": "",
      "format-full-prefix-font": "4",
      "format-full-prefix-foreground": "${color.cyan}",
      "label-full": "%percentage%%",
      "label-full-padding-left": "3pt",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-foreground": "${color.blue}",
      "ramp-capacity-font": "4"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\"%output%\"",
      "label-foreground": "${color.blue}"
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-font": "2",
      "label-focused": "%icon%",
      "label-focused-padding": "2",
      "label-focused-foreground": "${color.bg}",
      "label-focused-background": "${color.blue}",
      "label-occupied": "%icon%",
      "label-occupied-padding": "2",
      "label-occupied-foreground": "${color.indigo}",
      "label-urgent": "%icon%",
      "label-urgent-padding": "2",
      "label-urgent-foreground": "${color.indigo}",
      "label-empty": "%icon%",
      "label-empty-padding": "2",
      "label-empty-foreground": "${color.blue-gray}"
    },
    "title": {
      "type": "internal/xwindow",
      "format": "<label>",
      "format-prefix": "",
      "label": "%title%",
      "label-foreground": "${color.blue}",
      "label-maxlen": "35",
      "label-empty": "\"Arch Linux\""
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-font": "4",
      "format-prefix-foreground": "${color.blue}",
      "label": "%output%"
    },
    "launcher": {
      "type": "custom/text",
      "label": "\"󰣇\"",
      "label-foreground": "${color.blue-arch}",
      "label-font": "3",
      "label-padding-left": "10px"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.bg}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-foreground": "${color.blue}",
      "format-prefix-font": "4",
      "label": "\"%percentage%%\""
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-foreground": "${color.blue}",
      "format-prefix-font": "4",
      "label": "\"%used%\""
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "label-offline": "\"󰝛 No Music\"",
      "format-offline-foreground": "${color.grey}"
    },
    "mpd": {
      "type": "internal/mpd",
      "format-online": "\"%{F#ee5396}[%{F-} <label-song> %{F#ee5396}]%{F-}\"",
      "format-offline": "\"\"",
      "label-song": "\"%title%\"",
      "label-song-maxlen": "18"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\" \"",
      "label-font": "4",
      "label-foreground": "${color.blue}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\" \"",
      "label-font": "4",
      "label-foreground": "${color.blue}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"\"",
      "label-font": "4",
      "label-foreground": "${color.blue}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "4",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\" \"",
      "format-prefix-font": "4",
      "format-prefix-foreground": "${color.blue}",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\"",
      "label-font": "4",
      "label-foreground": "${color.blue}",
      "label-padding": "1"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
