  "modules": {
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "",
      "format-mounted-prefix-padding-right": "3pt",
      "label-mounted": "%used%",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix": "",
      "format-unmounted-prefix-padding-right": "3pt",
      "label-unmounted": "%mountpoint%: not mounted"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "",
      "format-connected-prefix-padding-right": "3pt",
      "label-connected": "\"%netspeed%\"",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "",
      "format-disconnected-prefix-padding-right": "3pt",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-foreground": "${color.red}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "\"%percentage%%\"",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "2",
      "ramp-padding-right": "3pt",
      "ramp-foreground": "${color.yellow}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "label-charging": "\"%percentage%% | \"",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "label-discharging": "\"%percentage%% | \"",
      "format-full": "<label-full>",
      "format-full-prefix": "",
      "format-full-prefix-padding-right": "3pt",
      "format-full-prefix-font": "2",
      "label-full": "\"%percentage%% | \"",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-padding-right": "3pt",
      "ramp-capacity-font": "2"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\"%output%\""
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"\"",
      "format-volume-prefix-padding-right": "3pt",
      "label-volume": "\"%percentage%\"",
      "label-volume-foreground": "${color.fg}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "\"\"",
      "format-muted-prefix-padding-right": "3pt",
      "label-muted": "\"Muted\"",
      "label-muted-foreground": "${color.red}"
    },
    "title": {
      "type": "internal/xwindow",
      "format": "<label>",
      "label": "\"%title%\"",
      "label-maxlen": "40",
      "label-empty": "\"Arch Linux\""
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "label-focused": "󱓇",
      "label-focused-foreground": "${color.fg}",
      "label-occupied": "%icon%",
      "label-occupied-foreground": "${color.fg}",
      "label-urgent": "%icon%",
      "label-urgent-foreground": "${color.fg}",
      "label-empty": "%icon%",
      "label-empty-foreground": "${color.black}",
      "label-separator": "\"•\"",
      "label-separator-padding": "1",
      "label-separator-foreground": "${color.fg}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "",
      "format-prefix-padding-right": "3pt",
      "label": "%output%"
    },
    "launcher": {
      "type": "custom/text",
      "label": "󰣇󰫿󰫰󰫵",
      "label-foreground": "${color.blue-arch}",
      "label-font": "2"
    },
    "sep": {
      "type": "custom/text",
      "label": "\"|\"",
      "label-padding": "5pt"
    },
    "sep2": {
      "type": "custom/text",
      "label": "\" \""
    },
    "cpu": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-padding-right": "3pt",
      "label": "%percentage%%"
    },
    "memory": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-padding-right": "3pt",
      "label": "%used%"
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "format-offline-foreground": "${color.grey}",
      "label-offline": "\"󰝛 no Music\""
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\"\""
    },
    "usercard": {
      "type": "custom/text",
      "label": "\"\""
    },
    "power": {
      "type": "custom/text",
      "label": "\"\""
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "2",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\" \"",
      "format-prefix-font": "3",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\""
    }
  },
  "status": "migrado; teste gráfico pendente"
}
