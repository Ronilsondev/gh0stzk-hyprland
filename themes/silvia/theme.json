{
  "name": "silvia",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#282828",
    "fg": "#fbf1c7",
    "black": "#a89984",
    "red": "#cc241d",
    "green": "#98971a",
    "yellow": "#d79921",
    "blue": "#458588",
    "magenta": "#b16286",
    "cyan": "#689d6a",
    "white": "#ebdbb2",
    "blackb": "#a89984",
    "redb": "#fb4934",
    "greenb": "#b8bb26",
    "yellowb": "#fabd2f",
    "blueb": "#83a598",
    "magentab": "#d3869b",
    "cyanb": "#8ec07c",
    "whiteb": "#ebdbb2",
    "accent_color": "#2E2E2E",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "46",
    "BOTTOM_PADDING": "1",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#d3869b",
    "FOCUSED_BC": "#fbf1c7",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "true",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "6",
    "P_BLUR": "false",
    "P_ANIMATIONS": "#",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(0, 20)",
    "dunst_origin": "bottom-center",
    "dunst_transparency": "0",
    "dunst_corner_radius": "6",
    "dunst_font": "JetBrainsMono NF Medium 9",
    "dunst_border": "0",
    "dunst_frame_color": "#98971a",
    "dunst_icon_theme": "Gruvbox-Plus-Dark",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "down",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "down",
    "jg_bg": "#282828",
    "jg_fg": "#fbf1c7",
    "jg_sel_bg": "#d79921",
    "jg_sel_fg": "#282828",
    "jg_sep": "#a89984",
    "rofi_font": "scientifica 12",
    "rofi_background": "#282828",
    "rofi_bg_alt": "#2E2E2E",
    "rofi_background_alt": "#282828E0",
    "rofi_fg": "#fbf1c7",
    "rofi_selected": "#d79921",
    "rofi_active": "#98971a",
    "rofi_urgent": "#cc241d",
    "sl_bg": "#282828",
    "sl_fg": "#fbf1c7",
    "sl_ring": "#d79921",
    "sl_wrong": "#cc241d",
    "sl_date": "#fbf1c7",
    "sl_verify": "#98971a",
    "gtk_theme": "Gruvbox-zk",
    "gtk_icons": "Gruvbox-Plus-Dark",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-Gruvbox",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-01.webp",
  "bar_colors": {
    "bg": "#3c3836",
    "bg-alt": "#708491",
    "fg": "#ebdbb2",
    "trans": "#00000000",
    "white": "#FFFFFF",
    "black": "#000000",
    "red": "#cc241d",
    "pink": "#d3869b",
    "purple": "#b16286",
    "blue": "#458588",
    "cyan": "#689d6a",
    "teal": "#00B19F",
    "green": "#98971a",
    "lime": "#8ec07c",
    "yellow": "#d79921",
    "amber": "#fac33b",
    "orange": "#d65d0e",
    "brown": "#AC8476",
    "grey": "#928374",
    "indigo": "#6C77BB",
    "blue-gray": "#6D8895"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "false",
      "width": "100%",
      "height": "45",
      "offset-x": "0",
      "offset-y": "0",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "0",
      "line-size": "3",
      "line-color": "${color.blue}",
      "border-size": "0",
      "border-color": "${color.bg}",
      "padding-left": "2",
      "padding-right": "0",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"JetBrainsMono:style=Bold:size=9;1\"",
      "font-1": "\"Material Design Icons Desktop:size=13;3\"",
      "font-2": "\"Font Awesome 6 Free Solid:size=9;2\"",
      "font-3": "\"Material Design Icons Desktop:size=18;3\"",
      "modules-left": "launcher sep2 bspwm sep2 title",
      "modules-center": "",
      "modules-right": "colorpicker usercard mplayer power sep2 bluetooth sep battery sep weather sep updates sep filesystem sep cpu_bar sep memory_bar sep pulseaudio sep network sep date sep tray sep",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "cata-bar"
    }
  ],
  "modules": {
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "format-prefix": "",
      "format-prefix-padding-right": "3pt",
      "label": "\"%time%%date%\"",
      "format-underline": "${color.indigo}"
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "",
      "format-mounted-prefix-padding-right": "3pt",
      "format-mounted-underline": "${color.red}",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix": "",
      "format-unmounted-prefix-padding-right": "3pt",
      "format-unmounted-underline": "${color.red}",
      "label-mounted": "%used%",
      "label-unmounted": "%mountpoint%: not mounted"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "",
      "format-connected-prefix-padding-right": "3pt",
      "label-connected": "\"%netspeed%\"",
      "format-connected-underline": "${color.orange}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "",
      "format-disconnected-prefix-padding-right": "3pt",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-foreground": "${color.red}",
      "format-disconnected-underline": "${color.orange}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "",
      "format-volume-prefix-padding-right": "3pt",
      "format-volume-underline": "${color.blue}",
      "label-volume": "%percentage%",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "",
      "format-muted-prefix-padding-right": "3pt",
      "format-muted-underline": "${color.blue}",
      "label-muted": "Muted",
      "label-muted-foreground": "${color.red}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "format-underline": "${color.yellow}",
      "label": "%percentage%%",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "3",
      "ramp-padding-right": "3pt"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "format-charging-underline": "${color.indigo}",
      "label-charging": "%percentage%%",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "format-discharging-underline": "${color.indigo}",
      "label-discharging": "%percentage%%",
      "format-full": "<label-full>",
      "format-full-underline": "${color.indigo}",
      "format-full-prefix": "",
      "format-full-prefix-font": "3",
      "format-full-prefix-padding-right": "3pt",
      "label-full": "%percentage%%",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-font": "3",
      "ramp-capacity-padding-right": "3pt"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "%output%",
      "format-underline": "${color.yellow}"
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-font": "2",
      "label-focused": "󰺕",
      "label-focused-padding": "1",
      "label-focused-foreground": "${color.lime}",
      "label-occupied": "󰀚",
      "label-occupied-padding": "1",
      "label-urgent": "󰀚",
      "label-urgent-padding": "0",
      "label-empty": "󰑊",
      "label-empty-padding": "1",
      "label-empty-foreground": "${color.grey}"
    },
    "title": {
      "type": "internal/xwindow",
      "format": "<label>",
      "format-prefix": "󱂬",
      "format-prefix-padding-right": "3pt",
      "format-prefix-foreground": "${color.pink}",
      "label": "%title%",
      "label-maxlen": "35",
      "label-empty": "Arch Linux",
      "label-empty-foreground": "${color.grey}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "",
      "format-prefix-padding-right": "3pt",
      "format-underline": "${color.green}",
      "label": "%output%"
    },
    "launcher": {
      "type": "custom/text",
      "label": "󰣇",
      "label-font": "4",
      "label-foreground": "${color.fg}"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-padding": "3pt",
      "label-foreground": "${color.bg-alt}"
    },
    "sep2": {
      "type": "custom/text",
      "label": "\" 󰇙 \"",
      "label-font": "2",
      "label-foreground": "${color.indigo}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "",
      "format-prefix-padding-right": "3pt",
      "label": "%percentage%%",
      "format-underline": "${color.cyan}"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "",
      "format-prefix-padding-right": "3pt",
      "format-underline": "${color.purple}",
      "label": "%used%"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "",
      "label-padding-right": "1",
      "label-foreground": "${color.green}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "",
      "label-padding-right": "1",
      "label-foreground": "${color.cyan}"
    },
    "power": {
      "type": "custom/text",
      "label": "",
      "label-foreground": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "2",
      "format-underline": "${color.blue}",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\"\"",
      "format-prefix-padding-right": "3pt",
      "format-prefix-font": "2",
      "format-underline": "${color.purple}",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.pink}",
      "label-padding-right": "1"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
