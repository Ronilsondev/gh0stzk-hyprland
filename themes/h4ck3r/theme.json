    "red": "#6DDE00",
    "pink": "#FF0677",
    "purple": "#9cf542",
    "blue": "#578a29",
    "blue-arch": "#0A9CF5",
    "cyan": "#539e06",
    "teal": "#00B19F",
    "green": "#00fa5c",
    "lime": "#B9C244",
    "yellow": "#76EA00",
    "amber": "#FBC02D",
    "orange": "#E57C46",
    "brown": "#AC8476",
    "grey": "#8C8C8C",
    "indigo": "#6C77BB",
    "blue-gray": "#6D8895"
