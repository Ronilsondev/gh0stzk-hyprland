{
  "name": "aline",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#faf4ed",
    "fg": "#575279",
    "black": "#f2e9e1",
    "red": "#b4637a",
    "green": "#286983",
    "yellow": "#ea9d34",
    "blue": "#56949f",
    "magenta": "#907aa9",
    "cyan": "#d7827e",
    "white": "#575279",
    "blackb": "#9893a5",
    "redb": "#b4637a",
    "greenb": "#286983",
    "yellowb": "#ea9d34",
    "blueb": "#56949f",
    "magentab": "#907aa9",
    "cyanb": "#d7827e",
    "whiteb": "#575279",
    "accent_color": "#f2e9e1",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "51",
    "BOTTOM_PADDING": "1",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#286983",
    "FOCUSED_BC": "#907aa9",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "true",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "6",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(20, 60)",
    "dunst_origin": "top-right",
    "dunst_transparency": "8",
    "dunst_corner_radius": "6",
    "dunst_font": "Inconsolata Semi Condensed Bold 9",
    "dunst_border": "0",
    "dunst_frame_color": "#575279",
    "dunst_icon_theme": "Gruvbox-Plus-Dark",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "up",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "right",
    "jg_bg": "#faf4ed",
    "jg_fg": "#575279",
    "jg_sel_bg": "#f2e9e1",
    "jg_sel_fg": "#575279",
    "jg_sep": "#907aa9",
    "rofi_font": "JetBrainsMono NF Bold 9",
    "rofi_background": "#faf4ed",
    "rofi_bg_alt": "#f2e9e1",
    "rofi_background_alt": "#faf4edE0",
    "rofi_fg": "#575279",
    "rofi_selected": "#d7827e",
    "rofi_active": "#286983",
    "rofi_urgent": "#ea9d34",
    "sl_bg": "#faf4ed",
    "sl_fg": "#f2e9e1",
    "sl_ring": "#907aa9",
    "sl_wrong": "#b4637a",
    "sl_date": "#f2e9e1",
    "sl_verify": "#286983",
    "gtk_theme": "RosePineDawn-zk",
    "gtk_icons": "Luv-Folders",
    "gtk_cursor": "Qogirr",
    "geany_theme": "z0mbi3-RosePineDawn",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-01.webp",
  "bar_colors": {
    "bg": "#faf4ed",
    "bg-alt": "#708491",
    "fg": "#575279",
    "mc": "#f2e9e1",
    "white": "#575279",
    "black": "#9893a5",
    "red": "#b4637a",
    "green": "#286983",
    "yellow": "#ea9d34",
    "blue": "#56949f",
    "purple": "#907aa9",
    "cyan": "#d7827e",
    "pink": "#eb6f92",
    "teal": "#9ccfd8",
    "lime": "#B9C515",
    "amber": "#f6c177",
    "orange": "#fab387",
    "brown": "#AC8476",
    "grey": "#8C8C8C",
    "indigo": "#31748f",
    "blue-gray": "#6e6a86"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "false",
      "width": "82%",
      "height": "28",
      "offset-x": "9%",
      "offset-y": "0",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius-bottom": "1.0",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-size": "11px",
      "border-color": "${color.bg}",
      "padding-left": "1",
      "padding-right": "1",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"Inconsolata Semi Condensed Bold:size=11;1\"",
      "font-1": "\"Font Awesome 6 Free Solid:size=11;3\"",
      "font-2": "\"Material Design Icons Desktop:size=17;4\"",
      "font-3": "\"MesloLGS NF:style=Regular:size=17;4\"",
      "font-4": "\"Font Awesome 6 Free Solid:size=9;3\"",
      "font-5": "\"Material Design Icons Desktop:size=13;4\"",
      "modules-left": "launcher sep bi bspwm bd sep usercard mplayer power",
      "modules-center": "bi date weather bd",
      "modules-right": "colorpicker bluetooth sep bi filesystem cpu_bar memory_bar bd sep bi battery pulseaudio network bd sep bi updates bd sep tray",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "aline-bar"
    }
  ],
  "modules": {
    "bi": {
      "type": "custom/text",
      "label": "\"%{T4}%{T-}\"",
      "label-foreground": "${color.mc}",
      "label-background": "${color.bg}"
    },
    "bd": {
      "type": "custom/text",
      "label": "\"%{T4}%{T-}\"",
      "label-foreground": "${color.mc}",
      "label-background": "${color.bg}"
    },
    "date": {
      "type": "internal/date",
      "time": "\"%I:%M %P\"",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "format-prefix": "\"\"",
      "label": "\"%time%%date%\"",
      "label-background": "${color.mc}"
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\"\"",
      "format-mounted-prefix-background": "${color.mc}",
      "format-mounted-prefix-foreground": "${color.purple}",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix": "\"\"",
      "format-unmounted-prefix-background": "${color.mc}",
      "format-unmounted-prefix-foreground": "${color.purple}",
      "label-mounted": "\"%used%\"",
      "label-mounted-padding": "1",
      "label-mounted-background": "${color.mc}",
      "label-unmounted": "%mountpoint%: not mounted",
      "label-unmounted-padding": "1",
      "label-unmounted-background": "${color.mc}"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\"\"",
      "format-connected-prefix-foreground": "${color.green}",
      "format-connected-background": "${color.mc}",
      "label-connected": "\" %downspeed%\"",
      "label-connected-background": "${color.mc}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\"\"",
      "format-disconnected-background": "${color.mc}",
      "format-disconnected-prefix-foreground": "${color.red}",
      "label-disconnected": "\" Offline\""
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"\"",
      "format-volume-prefix-foreground": "${color.teal}",
      "format-volume-background": "${color.mc}",
      "label-volume": "\"%percentage%\"",
      "label-volume-padding": "1",
      "format-muted": "<label-muted>",
      "format-muted-background": "${color.mc}",
      "format-muted-prefix": "\"\"",
      "format-muted-prefix-foreground": "${color.teal}",
      "label-muted": "\"Muted\"",
      "label-muted-padding": "1",
      "label-muted-foreground": "${color.red}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "\"%percentage%%\"",
      "label-padding": "2 pt",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "2",
      "ramp-foreground": "${color.yellow}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "format-charging-background": "${color.mc}",
      "label-charging": "\"%percentage%%\"",
      "label-charging-padding": "1",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "format-discharging-background": "${color.mc}",
      "label-discharging": "\"%percentage%%\"",
      "label-discharging-padding": "1",
      "format-full": "<label-full>",
      "format-full-prefix": "\"\"",
      "format-full-prefix-font": "2",
      "format-full-background": "${color.mc}",
      "format-full-prefix-foreground": "${color.green}",
      "label-full": "\"%percentage%%\"",
      "label-full-padding": "1",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-foreground": "${color.yellow}",
      "ramp-capacity-font": "2"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "format-background": "${color.mc}",
      "label": "\" %output%\""
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "label-focused": "\"󰧞\"",
      "label-focused-font": "3",
      "label-focused-background": "${color.mc}",
      "label-focused-foreground": "${color.blue}",
      "label-occupied": "\"󰧞\"",
      "label-occupied-font": "3",
      "label-occupied-background": "${color.mc}",
      "label-occupied-foreground": "${color.fg}",
      "label-urgent": "\"󰧞\"",
      "label-urgent-font": "3",
      "label-urgent-background": "${color.mc}",
      "label-urgent-foreground": "${color.fg}",
      "label-empty": "%icon%",
      "label-empty-background": "${color.mc}",
      "label-empty-foreground": "${color.fg}",
      "label-separator": "\" \"",
      "label-separator-background": "${color.mc}",
      "label-separator-padding": "0"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\"\"",
      "label-font": "5",
      "label-background": "${color.bg}",
      "label-foreground": "${color.fg}"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\"\"",
      "label-font": "5",
      "label-padding": "8 pt",
      "label-background": "${color.bg}",
      "label-foreground": "${color.fg}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"\"",
      "label-font": "5",
      "label-background": "${color.bg}",
      "label-foreground": "${color.fg}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-background": "${color.mc}",
      "format-prefix-foreground": "${color.amber}",
      "label": "%output%",
      "label-background": "${color.mc}"
    },
    "launcher": {
      "type": "custom/text",
      "label": "\"󰣇\"",
      "label-background": "${color.bg}"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-background": "${color.bg}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-background": "${color.mc}",
      "format-prefix-foreground": "${color.cyan}",
      "label": "\"%percentage%%\"",
      "label-padding": "1"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-background": "${color.mc}",
      "format-prefix": "\"\"",
      "format-prefix-foreground": "${color.pink}",
      "label": "\" %used%\""
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "6",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-background": "${color.mc}",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-foreground": "${color.cyan}",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\""
    }
  },
  "status": "migrado; teste gráfico pendente"
}
