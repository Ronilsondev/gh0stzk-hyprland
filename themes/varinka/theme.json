{
  "name": "varinka",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#212529",
    "fg": "#f8f9fa",
    "black": "#2C3136",
    "red": "#dee2e6",
    "green": "#adb5bd",
    "yellow": "#e9ecef",
    "blue": "#495057",
    "magenta": "#ced4da",
    "cyan": "#6c757d",
    "white": "#f8f9fa",
    "blackb": "#343a40",
    "redb": "#dee2e6",
    "greenb": "#adb5bd",
    "yellowb": "#e9ecef",
    "blueb": "#495057",
    "magentab": "#ced4da",
    "cyanb": "#6c757d",
    "whiteb": "#f8f9fa",
    "accent_color": "#343a40",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "42",
    "BOTTOM_PADDING": "1",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#ced4da",
    "FOCUSED_BC": "#f8f9fa",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "true",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "6",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(0, 60)",
    "dunst_origin": "top-center",
    "dunst_transparency": "0",
    "dunst_corner_radius": "6",
    "dunst_font": "Maple Mono NF Bold Italic 9",
    "dunst_border": "0",
    "dunst_frame_color": "#f8f9fa",
    "dunst_icon_theme": "Vimix-White",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "up",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "up",
    "jg_bg": "#212529",
    "jg_fg": "#f8f9fa",
    "jg_sel_bg": "#ced4da",
    "jg_sel_fg": "#212529",
    "jg_sep": "#343a40",
    "rofi_font": "Terminess Nerd Font Mono Bold 10",
    "rofi_background": "#212529",
    "rofi_bg_alt": "#343a40",
    "rofi_background_alt": "#212529E0",
    "rofi_fg": "#f8f9fa",
    "rofi_selected": "#ced4da",
    "rofi_active": "#adb5bd",
    "rofi_urgent": "#dee2e6",
    "sl_bg": "#212529",
    "sl_fg": "#f8f9fa",
    "sl_ring": "#343a40",
    "sl_wrong": "#dee2e6",
    "sl_date": "#f8f9fa",
    "sl_verify": "#adb5bd",
    "gtk_theme": "MonochromeBlue-zk",
    "gtk_icons": "Vimix-White",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-Monochromatic",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-11.webp",
  "bar_colors": {
    "bg": "#FA212529",
    "bg-alt": "#000000",
    "fg": "#f8f9fa",
    "red": "#dee2e6",
    "pink": "#dc5bbc",
    "purple": "#ced4da",
    "blue": "#495057",
    "cyan": "#6c757d",
    "teal": "#00B19F",
    "green": "#adb5bd",
    "lime": "#B9C244",
    "yellow": "#e9ecef",
    "amber": "#fac33b",
    "orange": "#de8658",
    "brown": "#AC8476",
    "grey": "#8C8C8C",
    "indigo": "#6C77BB",
    "blue-gray": "#6D8895"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "false",
      "width": "96%",
      "height": "35",
      "offset-x": "2%",
      "offset-y": "3",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "8",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-size": "2",
      "border-color": "${color.bg-alt}",
      "padding-left": "2",
      "padding-right": "2",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"Maple Mono NF:style=Bold Italic:size=8;3\"",
      "font-1": "\"Maple Mono NF:style=Bold:size=10;2\"",
      "font-2": "\"Maple Mono NF:style=Bold:size=15;5\"",
      "font-3": "\"Maple Mono NF:style=Bold:size=14;4\"",
      "font-4": "\"Maple Mono NF:style=Bold:size=28;7\"",
      "modules-left": "launcher sep sep bspwm sep sep2 sep title",
      "modules-center": "",
      "modules-right": "colorpicker weather spl mplayer sep usercard spr sep mpd_control sep sep sep2 bluetooth sep battery sep updates sep xkeyboard sep filesystem sep cpu_bar sep memory_bar sep pulseaudio sep network sep2 tray sep date sep power",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "varinka-bar"
    }
  ],
  "modules": {
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "format-foreground": "${color.fg}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix-font": "2",
      "format-mounted-prefix": "\"󰄦\"",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix-font": "2",
      "format-unmounted-prefix": "\"󰄦\"",
      "label-mounted": "\"%used% \"",
      "label-mounted-padding-left": "8pt",
      "label-mounted-foreground": "${color.purple}",
      "label-unmounted": "%mountpoint%: not mounted",
      "label-unmounted-padding-left": "8pt",
      "label-unmounted-foreground": "${color.purple}"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\"󰖩\"",
      "format-connected-prefix-font": "2",
      "label-connected": "\"%netspeed%  \"",
      "label-connected-padding-left": "8pt",
      "label-connected-foreground": "${color.purple}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\"󰖪\"",
      "format-disconnected-prefix-font": "2",
      "label-disconnected": "\"Offline  \"",
      "label-disconnected-padding-left": "8pt",
      "label-disconnected-foreground": "${color.purple}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"\"",
      "format-volume-font": "2",
      "label-volume": "\"%percentage% \"",
      "label-volume-padding-left": "8pt",
      "label-volume-foreground": "${color.purple}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "\"\"",
      "format-muted-prefix-font": "2",
      "label-muted": "\"Muted \"",
      "label-muted-padding-left": "8pt",
      "label-muted-foreground": "${color.red}"
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "\"%percentage%%\"",
      "label-padding": "8pt",
      "label-foreground": "${color.purple}",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "2"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "label-charging": "%percentage%%",
      "label-charging-foreground": "${color.purple}",
      "label-charging-padding": "8pt",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "label-discharging": "%percentage%%",
      "label-discharging-foreground": "${color.purple}",
      "label-discharging-padding": "8pt",
      "format-full": "<label-full>",
      "format-full-prefix": "",
      "format-full-prefix-font": "2",
      "label-full": "%percentage%%",
      "label-full-foreground": "${color.purple}",
      "label-full-padding": "8pt",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-font": "2"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\" %output%\""
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-font": "5",
      "label-focused": "%icon%",
      "label-focused-foreground": "${color.fg}",
      "label-occupied": "%icon%",
      "label-occupied-foreground": "${color.green}",
      "label-urgent": "%icon%",
      "label-urgent-foreground": "${color.green}",
      "label-empty": "%icon%",
      "label-empty-foreground": "${color.blue}"
    },
    "title": {
      "type": "internal/xwindow",
      "format": "<label>",
      "format-prefix": "",
      "label": "%title%",
      "label-foreground": "${color.purple}",
      "label-maxlen": "35",
      "label-empty": "\"Arch Linux\"",
      "label-empty-foreground": "${color.green}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\"\"",
      "format-prefix-font": "2",
      "label": "\"%output% \"",
      "label-padding-left": "8pt",
      "label-foreground": "${color.purple}"
    },
    "launcher": {
      "type": "custom/text",
      "label": "󰣇",
      "label-font": "3",
      "label-foreground": "${color.red}"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.bg}"
    },
    "sep2": {
      "type": "custom/text",
      "label": "\" \"",
      "label-font": "4",
      "label-foreground": "${color.yellow}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-font": "2",
      "format-prefix": "\"\"",
      "label": "\"%percentage%% \"",
      "label-padding-left": "8pt"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\"󰄧\"",
      "format-font": "2",
      "label": "\"%used% \"",
      "label-padding-left": "8pt",
      "label-foreground": "${color.purple}"
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "label-offline": "\"󰎊 No Music\"",
      "label-offline-font": "2",
      "format-offline-foreground": "${color.grey}"
    },
    "spl": {
      "type": "custom/text",
      "label": "\"[\"",
      "label-padding-right": "3pt",
      "label-font": "2",
      "label-foreground": "${color.blue}"
    },
    "spr": {
      "type": "custom/text",
      "label": "\"]\"",
      "label-padding-left": "3pt",
      "label-font": "2",
      "label-foreground": "${color.blue}"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\" \"",
      "label-padding-right": "3pt",
      "label-font": "2",
      "label-foreground": "${color.green}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\" \"",
      "label-font": "2",
      "label-foreground": "${color.green}"
    },
    "power": {
      "type": "custom/text",
      "label": "\" \"",
      "label-font": "2",
      "label-foreground": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "2",
      "label": "\"%output% \""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\"󰌌\"",
      "format-prefix-padding-right": "8pt",
      "format-prefix-font": "2",
      "label-layout": "\"%layout% \"",
      "label-layout-foreground": "${color.purple}"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"󰈋\"",
      "label-font": "2",
      "label-foreground": "${color.purple}"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
