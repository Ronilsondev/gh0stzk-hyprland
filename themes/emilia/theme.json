{
  "name": "emilia",
  "source_commit": "bbcd8b00e537ddad63d34a0c448e5bd539078fcb",
  "palette": {
    "bg": "#1a1b26",
    "fg": "#c0caf5",
    "black": "#15161e",
    "red": "#f7768e",
    "green": "#9ece6a",
    "yellow": "#e0af68",
    "blue": "#7aa2f7",
    "magenta": "#bb9af7",
    "cyan": "#7dcfff",
    "white": "#a9b1d6",
    "blackb": "#414868",
    "redb": "#f7768e",
    "greenb": "#9ece6a",
    "yellowb": "#e0af68",
    "blueb": "#7aa2f7",
    "magentab": "#bb9af7",
    "cyanb": "#7dcfff",
    "whiteb": "#c0caf5",
    "accent_color": "#222330",
    "arch_icon": "#0f94d2",
    "BORDER_WIDTH": "0",
    "TOP_PADDING": "50",
    "BOTTOM_PADDING": "1",
    "LEFT_PADDING": "1",
    "RIGHT_PADDING": "1",
    "NORMAL_BC": "#414868",
    "FOCUSED_BC": "#bb9af7",
    "term_font_size": "10",
    "term_font_name": "JetBrainsMono Nerd Font",
    "P_FADE": "true",
    "P_SHADOWS": "true",
    "SHADOW_C": "#000000",
    "P_CORNER_R": "6",
    "P_BLUR": "false",
    "P_ANIMATIONS": "@",
    "P_TERM_OPACITY": "1.0",
    "dunst_offset": "(20, 60)",
    "dunst_origin": "top-right",
    "dunst_transparency": "0",
    "dunst_corner_radius": "6",
    "dunst_font": "JetBrainsMono NF Medium 9",
    "dunst_border": "0",
    "dunst_frame_color": "#222330",
    "dunst_icon_theme": "TokyoNight-SE",
    "dunst_close_preset": "fly-out",
    "dunst_close_direction": "up",
    "dunst_open_preset": "fly-in",
    "dunst_open_direction": "up",
    "jg_bg": "#1a1b26",
    "jg_fg": "#c0caf5",
    "jg_sel_bg": "#222330",
    "jg_sel_fg": "#c0caf5",
    "jg_sep": "#414868",
    "rofi_font": "JetBrainsMono NF Bold 9",
    "rofi_background": "#1a1b26",
    "rofi_bg_alt": "#222330",
    "rofi_background_alt": "#1a1b26E0",
    "rofi_fg": "#c0caf5",
    "rofi_selected": "#7aa2f7",
    "rofi_active": "#9ece6a",
    "rofi_urgent": "#f7768e",
    "sl_bg": "#1a1b26",
    "sl_fg": "#c0caf5",
    "sl_ring": "#15161e",
    "sl_wrong": "#f7768e",
    "sl_date": "#c0caf5",
    "sl_verify": "#9ece6a",
    "gtk_theme": "TokyoNight-zk",
    "gtk_icons": "TokyoNight-SE",
    "gtk_cursor": "Qogirr-Dark",
    "geany_theme": "z0mbi3-TokyoNight",
    "ENGINE": "Default"
  },
  "wallpaper": "walls/wall-01.webp",
  "bar_colors": {
    "bg": "#1A1B26",
    "fg": "#F1F1F1",
    "mb": "#222330",
    "red": "#f7768e",
    "pink": "#FF0677",
    "purple": "#583794",
    "blue": "#7aa2f7",
    "blue-arch": "#0A9CF5",
    "cyan": "#7dcfff",
    "teal": "#00B19F",
    "green": "#9ece6a",
    "lime": "#B9C244",
    "yellow": "#e0af68",
    "amber": "#FBC02D",
    "orange": "#E57C46",
    "brown": "#AC8476",
    "grey": "#8C8C8C",
    "indigo": "#6C77BB",
    "blue-gray": "#6D8895"
  },
  "bars": [
    {
      "override-redirect": "false",
      "bottom": "false",
      "fixed-center": "true",
      "width": "90%",
      "height": "26",
      "offset-x": "5%",
      "offset-y": "8",
      "background": "${color.bg}",
      "foreground": "${color.fg}",
      "radius": "4.0",
      "line-size": "2",
      "line-color": "${color.blue}",
      "border-size": "8px",
      "border-color": "${color.bg}",
      "padding": "1",
      "module-margin-left": "0",
      "module-margin-right": "0",
      "font-0": "\"JetBrainsMono:style=Bold:pixelsize=9;3\"",
      "font-1": "\"Font Awesome 6 Free Solid:size=10;3\"",
      "font-2": "\"Material Design Icons Desktop:size=11;3\"",
      "font-3": "\"Material Design Icons Desktop:size=15;4\"",
      "font-4": "\"MesloLGS NF:style=Regular:pixelsize=17;4\"",
      "modules-left": "launcher dots bi cpu_bar bd sep bi memory_bar bd sep bi filesystem bd sep bi mpd_control bd sep colorpicker",
      "modules-center": "bi bspwm bd",
      "modules-right": "mplayer sep mpd sep bluetooth sep bi battery network bd sep bi pulseaudio bd sep bi updates bd sep bi date bd sep tray sep power",
      "separator": "",
      "dim-value": "1.0",
      "cursor-click": "pointer",
      "cursor-scroll": "",
      "name": "emi-bar"
    }
  ],
  "modules": {
    "bi": {
      "type": "custom/text",
      "label": "\"%{T5}%{T-}\"",
      "label-foreground": "${color.mb}",
      "label-background": "${color.bg}"
    },
    "bd": {
      "type": "custom/text",
      "label": "\"%{T5}%{T-}\"",
      "label-foreground": "${color.mb}",
      "label-background": "${color.bg}"
    },
    "date": {
      "type": "internal/date",
      "time": "%I:%M %P",
      "format-background": "${color.mb}",
      "format-foreground": "${color.fg}",
      "date-alt": "\"%a, %d %b %Y\"",
      "format": "<label>",
      "format-prefix": "",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.mb}",
      "format-prefix-foreground": "${color.blue-gray}",
      "label": "\"%time%%date%\""
    },
    "filesystem": {
      "type": "internal/fs",
      "format-mounted": "<label-mounted>",
      "format-mounted-prefix": "\" \"",
      "format-mounted-prefix-font": "2",
      "format-mounted-prefix-background": "${color.mb}",
      "format-mounted-prefix-foreground": "${color.amber}",
      "format-unmounted": "<label-unmounted>",
      "format-unmounted-prefix-font": "2",
      "format-unmounted-prefix": "\" \"",
      "label-mounted": "%used%",
      "label-mounted-background": "${color.mb}",
      "label-unmounted": "%mountpoint%: not mounted"
    },
    "network": {
      "type": "internal/network",
      "format-connected": "<label-connected>",
      "format-connected-prefix": "\" \"",
      "format-connected-prefix-font": "2",
      "format-connected-background": "${color.mb}",
      "format-connected-foreground": "${color.green}",
      "label-connected": "\"%netspeed%\"",
      "label-connected-background": "${color.mb}",
      "label-connected-foreground": "${color.amber}",
      "format-disconnected": "<label-disconnected>",
      "format-disconnected-prefix": "\" \"",
      "format-disconnected-prefix-font": "2",
      "format-disconnected-prefix-background": "${color.mb}",
      "format-disconnected-foreground": "${color.red}",
      "label-disconnected": "\"Offline\"",
      "label-disconnected-background": "${color.mb}",
      "label-disconnected-foreground": "${color.red}"
    },
    "pulseaudio": {
      "type": "internal/pulseaudio",
      "format-volume": "<label-volume>",
      "format-volume-prefix": "\"\"",
      "format-volume-prefix-font": "2",
      "format-volume-background": "${color.mb}",
      "format-volume-foreground": "${color.indigo}",
      "label-volume": "\" %percentage% \"",
      "label-volume-background": "${color.mb}",
      "label-volume-foreground": "${color.fg}",
      "format-muted": "<label-muted>",
      "format-muted-prefix": "",
      "format-muted-prefix-font": "2",
      "format-muted-foreground": "${color.indigo}",
      "format-muted-background": "${color.mb}",
      "label-muted": "\" Muted \"",
      "label-muted-foreground": "${color.red}",
      "label-muted-background": "${color.mb}",
      "ramp-volume-0": "",
      "ramp-volume-1": "",
      "ramp-volume-2": "",
      "ramp-volume-3": "",
      "ramp-volume-4": ""
    },
    "brightness": {
      "type": "internal/backlight",
      "format": "<ramp><label>",
      "label": "%percentage%%",
      "label-padding-left": "3pt",
      "ramp-0": "",
      "ramp-1": "",
      "ramp-2": "",
      "ramp-font": "2",
      "ramp-foreground": "${color.yellow}"
    },
    "battery": {
      "type": "internal/battery",
      "time-format": "%H:%M",
      "format-charging": "<animation-charging><label-charging>",
      "format-charging-background": "${color.mb}",
      "label-charging": "%percentage%%",
      "label-charging-padding-left": "3pt",
      "label-charging-padding-right": "7pt",
      "format-discharging": "<ramp-capacity><label-discharging>",
      "format-discharging-background": "${color.mb}",
      "label-discharging": "%percentage%%",
      "label-discharging-padding-left": "3pt",
      "label-discharging-padding-right": "7pt",
      "format-full": "<label-full>",
      "format-full-background": "${color.mb}",
      "format-full-prefix": "",
      "format-full-prefix-font": "2",
      "format-full-prefix-foreground": "${color.green}",
      "label-full": "%percentage%%",
      "label-full-padding-left": "3pt",
      "label-full-padding-right": "7pt",
      "ramp-capacity-0": "",
      "ramp-capacity-1": "",
      "ramp-capacity-2": "",
      "ramp-capacity-3": "",
      "ramp-capacity-4": "",
      "ramp-capacity-foreground": "${color.blue}",
      "ramp-capacity-font": "2"
    },
    "weather": {
      "type": "custom/script",
      "format": "<label>",
      "label": "\" %output% \""
    },
    "bspwm": {
      "type": "internal/bspwm",
      "format": "<label-state>",
      "format-font": "3",
      "label-focused": "󰮯",
      "label-focused-background": "${color.mb}",
      "label-focused-padding": "1",
      "label-focused-foreground": "${color.yellow}",
      "label-occupied": "󰊠",
      "label-occupied-padding": "1",
      "label-occupied-background": "${color.mb}",
      "label-occupied-foreground": "${color.blue}",
      "label-urgent": "󰊠",
      "label-urgent-padding": "1",
      "label-urgent-background": "${color.mb}",
      "label-urgent-foreground": "${color.blue}",
      "label-empty": "󰑊",
      "label-empty-padding": "1",
      "label-empty-background": "${color.mb}",
      "label-empty-foreground": "${color.purple}"
    },
    "updates": {
      "type": "custom/ipc",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.mb}",
      "format-prefix-foreground": "${color.lime}",
      "label": "%output%",
      "label-background": "${color.mb}"
    },
    "launcher": {
      "type": "custom/text",
      "label": "󰣇",
      "label-foreground": "${color.blue-arch}",
      "label-font": "4"
    },
    "sep": {
      "type": "custom/text",
      "label": "\" \"",
      "label-foreground": "${color.bg}"
    },
    "dots": {
      "type": "custom/text",
      "label": "\" 󰇙 \"",
      "label-font": "3",
      "label-foreground": "${color.blue-gray}"
    },
    "cpu_bar": {
      "type": "internal/cpu",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.mb}",
      "format-prefix-foreground": "${color.red}",
      "label": "\"%percentage%%\"",
      "label-background": "${color.mb}"
    },
    "memory_bar": {
      "type": "internal/memory",
      "format": "<label>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-background": "${color.mb}",
      "format-prefix-foreground": "${color.cyan}",
      "label": "%used%",
      "label-background": "${color.mb}"
    },
    "mpd_control": {
      "type": "internal/mpd",
      "format-online": "<icon-prev><toggle><icon-next>",
      "format-offline": "<label-offline>",
      "label-offline": "\"󰝛 No Music\"",
      "format-offline-background": "${color.mb}",
      "format-offline-foreground": "${color.grey}"
    },
    "mpd": {
      "type": "internal/mpd",
      "format-online": "\"%{F#9ece6a}[%{F-} <label-song> %{F#9ece6a}]%{F-}\"",
      "format-offline": "\"\"",
      "label-song": "\"%title%\"",
      "label-song-maxlen": "18"
    },
    "mplayer": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.green}"
    },
    "usercard": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.cyan}"
    },
    "power": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.red}"
    },
    "tray": {
      "type": "internal/tray",
      "format": "<tray>",
      "format-background": "${color.bg}"
    },
    "bluetooth": {
      "type": "custom/script",
      "format": "<label>",
      "format-font": "3",
      "label": "\"%output%\""
    },
    "xkeyboard": {
      "type": "internal/xkeyboard",
      "format": "<label-layout>",
      "format-prefix": "\" \"",
      "format-prefix-font": "2",
      "format-prefix-foreground": "${color.cyan}",
      "label-layout": "%layout%"
    },
    "colorpicker": {
      "type": "custom/text",
      "label": "\"\"",
      "label-foreground": "${color.green}"
    }
  },
  "status": "migrado; teste gráfico pendente"
}
